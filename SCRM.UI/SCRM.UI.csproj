<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableStaticWebAssetsCompression>true</DisableStaticWebAssetsCompression>
    <EnableCompressedStaticWebAssets>false</EnableCompressedStaticWebAssets>
    <ErrorOnDuplicatePublishAssets>false</ErrorOnDuplicatePublishAssets>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="9.0.1" />
    <PackageReference Include="Radzen.Blazor" Version="8.3.5" />
    <PackageReference Include="TG.Blazor.IndexedDB" Version="1.5.0-preview" />
  </ItemGroup>

  <!-- <Import Project="..\SCRM.SHARED\SCRM.SHARED.projitems" Label="Shared" /> -->
  <ItemGroup>
      <ProjectReference Include="..\SCRM.SHARED\SCRM.SHARED.csproj" />
  </ItemGroup>

  <Target Name="SuppressDiscoverPrecompressedAssets" BeforeTargets="DiscoverPrecompressedAssets">
    <ItemGroup>
      <_PrecompressedStaticWebAsset Remove="@(_PrecompressedStaticWebAsset)" />
    </ItemGroup>
  </Target>
</Project>
