@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Authorization

<RadzenPanelMenu Style="height: 100%;">
    <AuthorizeView>
        <Authorized>
            <RadzenPanelMenuItem Text="首页" Path="" Icon="home" />
            <RadzenPanelMenuItem Text="IM 中心" Path="im" Icon="chat" />
            <RadzenPanelMenuItem Text="朋友圈" Path="moments" Icon="camera" />
            <RadzenPanelMenuItem Text="设备管理" Path="admin/devices" Icon="devices" />
            <RadzenPanelMenuItem Text="微信账号" Path="admin/wechat-accounts" Icon="people" />
            <RadzenPanelMenuItem Text="联系人" Path="contacts/all" Icon="contacts" />
            <RadzenPanelMenuItem Text="系统设置" Path="settings" Icon="settings" />
        </Authorized>
        <NotAuthorized>
            <RadzenPanelMenuItem Text="请先登录" Path="login" Icon="login" />
        </NotAuthorized>
    </AuthorizeView>
</RadzenPanelMenu>
 