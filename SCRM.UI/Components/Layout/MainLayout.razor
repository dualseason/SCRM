@inherits LayoutComponentBase
@using Radzen
@using Radzen.Blazor

<RadzenComponents />

<RadzenLayout Style="height: 100vh; grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body';">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="padding: 0 1rem; height: 100%;">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="SCRM 控制中心" Style="font-size: 1.25rem; font-weight: bold; margin-left: 1rem;" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@sidebarExpanded" Style="width: 250px; z-index: 2;">
        <NavMenu />
    </RadzenSidebar>
    <RadzenBody Style="height: calc(100vh - 51px); overflow: hidden;">
        <div style="height: 100%; width: 100%;">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@inject SCRM.UI.Services.WeChatService _weChatService
@inject NavigationManager _navigationManager
@inject HttpClient _httpClient

@code {
    bool sidebarExpanded = true;

    protected override async Task OnInitializedAsync()
    {
        // 确保 SignalR 服务连接
        // fix: 使用 API BaseAddress (因为 Client 和 API 是分离的) 且修正路径为 /hubs/client
        var hubUrl = new Uri(_httpClient.BaseAddress!, "hubs/client").ToString();
        await _weChatService.InitializeAsync(hubUrl);
    }
}

<style>
    /* 修正 Radzen Layout 在部分浏览器下的溢出问题 */
    .rz-layout {
        overflow: hidden;
    }
    .rz-body {
        padding: 0 !important;
    }
</style>
