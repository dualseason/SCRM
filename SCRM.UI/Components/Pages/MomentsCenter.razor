@page "/moments"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.UI.Components.Shared
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>朋友圈</PageTitle>

<div class="moments-layout" style="height: calc(100vh - 50px); display: flex; overflow: hidden;">
    <div class="device-sider" style="width: 80px; background: #2e2e2e; flex-shrink: 0; overflow-y: auto;">
        <DeviceList OnDeviceSelected="OnDeviceSelected" />
    </div>

    <div class="feed-content" style="flex: 1; background: #f0f2f5; padding: 1rem; overflow-y: auto; height: 100%;">
        <div class="feed-container" style="max-width: 600px; margin: 0 auto;">
            @if (Store.SelectedDevice == null)
            {
                <RadzenCard Class="rz-p-5 rz-text-align-center">
                    <RadzenIcon Icon="smartphone" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />
                    <RadzenText TextStyle="TextStyle.Body1" Class="rz-mt-4">请选择一个设备以查看朋友圈</RadzenText>
                </RadzenCard>
            }
            else
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-4">
                     <RadzenText TextStyle="TextStyle.H6" Class="rz-mb-0">@Store.SelectedDevice.weChatNick 的朋友圈</RadzenText>
                     <RadzenButton Text="同步朋友圈" Icon="sync" Click="SyncMoments" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
                </RadzenStack>

                @if (Store.CurrentMoments.Count == 0)
                {
                     <RadzenCard Class="rz-p-5 rz-text-align-center">
                        <RadzenText TextStyle="TextStyle.Body1">暂无朋友圈数据，请点击“同步”</RadzenText>
                    </RadzenCard>
                }
                else
                {
                    <RadzenStack Gap="1rem">
                    @foreach (var moment in Store.CurrentMoments)
                    {
                         <MomentsFeedItem Moment="@moment" />
                    }
                    </RadzenStack>
                }
            }
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Store.OnChange += HandleStoreChange;
    }
    
    public void Dispose()
    {
        Store.OnChange -= HandleStoreChange;
    }

    private void HandleStoreChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnDeviceSelected(SrClient device)
    {
        await Store.SelectDeviceAsync(device);
        await Store.LoadMomentsAsync();
    }

    private async Task SyncMoments()
    {
        await Store.RequestMomentsSyncAsync();
    }
}
