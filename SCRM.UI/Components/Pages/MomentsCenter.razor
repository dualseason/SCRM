    private static bool HasPoi(MomentPostPoiDto poi)
    {
        return !string.IsNullOrWhiteSpace(poi.city)
            || !string.IsNullOrWhiteSpace(poi.name)
            || !string.IsNullOrWhiteSpace(poi.address)
            || !string.IsNullOrWhiteSpace(poi.poiId)
            || Math.Abs(poi.lat) > 0.000001f
            || Math.Abs(poi.lng) > 0.000001f;
    }

    private string BuildMomentPostSafePreview()
    {
        var attachmentCount = BuildMomentAttachmentContents().Count;
        var labelsCount = BuildSelectedMomentPostLabelNames()
            .Concat(SplitMultiValueText(_visibleLabelsText))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        var friendsCount = (_selectedVisibleFriendWxids ?? Array.Empty<string>())
            .Concat(SplitMultiValueText(_visibleFriendsText))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        var notiCount = (_selectedNotiUserWxids ?? Array.Empty<string>())
            .Concat(SplitMultiValueText(_notiUsersText))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        var extCommentCount = SplitMultiValueText(_extCommentText).Count;
        return string.Join("｜", new[]
        {
            $"正文={FormatHasText(_postModel.content)}",
            $"附件={_postModel.attachment.type}/{attachmentCount}条",
            $"可见={_postModel.visible.type}",
            $"标签={labelsCount}",
            $"好友={friendsCount}",
            $"提醒={notiCount}",
            $"首评={FormatHasText(_postModel.comment)}",
            $"追加评论={extCommentCount}",
            $"POI={(HasPoi(_postModel.poi) ? "已填" : "未填")}",
            $"慢发={(_postModel.sendSlow ? "开" : "关")}"
        });
    }

    private static string FormatHasText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "无" : "有";
    }

    private static bool HasPoiListData(object? data)
    {
        return ExtractMomentPoiRawItems(data).Count > 0;
    }

    private static List<string> ExtractMomentPoiRawItems(object? data)
    {
        if (data == null)
        {
            return new List<string>();
        }

        if (data is JsonElement json)
        {
            return ExtractMomentPoiRawItems(json);
        }

        var property = data.GetType().GetProperty("poiList")
            ?? data.GetType().GetProperty("PoiList");
        var value = property?.GetValue(data);
        if (value is IEnumerable<string> strings)
        {
            return strings.Where(item => !string.IsNullOrWhiteSpace(item)).Select(item => item.Trim()).ToList();
        }

        if (value is System.Collections.IEnumerable enumerable && value is not string)
        {
            var items = new List<string>();
            foreach (var item in enumerable)
            {
                var text = item?.ToString();
                if (!string.IsNullOrWhiteSpace(text))
                {
                    items.Add(text.Trim());
                }
            }

            return items;
        }

        return new List<string>();
    }

    private static List<string> ExtractMomentPoiRawItems(JsonElement json)
    {
        if (json.ValueKind != JsonValueKind.Object)
        {
            return new List<string>();
        }

        if (!TryGetJsonProperty(json, out var poiList, "poiList", "PoiList") || poiList.ValueKind != JsonValueKind.Array)
        {
            return new List<string>();
        }

        var items = new List<string>();
        foreach (var item in poiList.EnumerateArray())
        {
            var text = item.ValueKind == JsonValueKind.String ? item.GetString() : item.ToString();
            if (!string.IsNullOrWhiteSpace(text))
            {
                items.Add(text.Trim());
            }
        }

        return items;
    }

    private static string ExtractMomentPoiKeyword(object? data)
    {
        if (data == null)
        {
            return string.Empty;
        }

        if (data is JsonElement json)
        {
            return json.ValueKind == JsonValueKind.Object && TryGetJsonProperty(json, out var keyword, "Keyword", "keyword")
                ? keyword.GetString() ?? string.Empty
                : string.Empty;
        }

        var property = data.GetType().GetProperty("Keyword") ?? data.GetType().GetProperty("keyword");
        return property?.GetValue(data)?.ToString() ?? string.Empty;
    }

    private static bool TryBuildMomentPoiOption(string raw, int index, out MomentPoiOption option)
    {
        option = new MomentPoiOption
        {
            Raw = raw,
            Name = raw,
            Text = $"{index}. {FormatShortText(raw, 90)}"
        };

        if (string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        try
        {
            using var document = JsonDocument.Parse(raw);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                return true;
            }

            var root = document.RootElement;
            option.Name = GetJsonString(root, "Name", "name");
            option.City = GetJsonString(root, "City", "city");
            option.Address = GetJsonString(root, "Address", "address");
            option.PoiId = GetJsonString(root, "PoiId", "poiId", "POIId", "poiid");
            option.Province = GetJsonString(root, "Province", "province");
            option.District = GetJsonString(root, "District", "district");
            option.Lat = GetJsonDouble(root, "Lat", "lat", "Latitude", "latitude");
            option.Lng = GetJsonDouble(root, "Lng", "lng", "Longitude", "longitude");
            option.Text = $"{index}. {FirstNonEmpty(option.Name, option.Address, option.PoiId, "未命名 POI")}"
                + (string.IsNullOrWhiteSpace(option.City) ? string.Empty : $"｜{option.City}")
                + (Math.Abs(option.Lat) > 0.000001d || Math.Abs(option.Lng) > 0.000001d ? $"｜{option.Lat:F6},{option.Lng:F6}" : string.Empty);
            return true;
        }
        catch (JsonException)
        {
            return true;
        }
    }

    private static string GetJsonString(JsonElement root, params string[] names)
    {
        return TryGetJsonProperty(root, out var value, names)
            ? value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString()
            : string.Empty;
    }

    private static double GetJsonDouble(JsonElement root, params string[] names)
    {
        if (!TryGetJsonProperty(root, out var value, names))
        {
            return 0d;
        }

        return value.ValueKind switch
        {
            JsonValueKind.Number when value.TryGetDouble(out var number) => number,
            JsonValueKind.String when double.TryParse(value.GetString(), out var number) => number,
            _ => 0d
        };
    }

    private static bool TryGetJsonProperty(JsonElement root, out JsonElement value, params string[] names)
    {
        foreach (var name in names)
        {
            if (root.TryGetProperty(name, out value))
            {
                return true;
            }
        }

        value = default;
        return false;
    }

    private static string FormatShortText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        var trimmed = value.Trim();
        return trimmed.Length <= maxLength ? trimmed : trimmed[..maxLength] + "...";
    }

    private static List<string> SplitMultiValueText(string? value)
    {
        return (value ?? string.Empty)
            .Split(new[] { "\r\n", "\n", "\r", ",", "，", ";", "；" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

