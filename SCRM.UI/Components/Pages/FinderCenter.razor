    private static DateTimeOffset? GetLatestReceivedAt(IEnumerable<DateTimeOffset> values)

    {

        DateTimeOffset? latest = null;

        foreach (var value in values)

        {

            if (!latest.HasValue || value > latest.Value)

            {

                latest = value;

            }

        }

        return latest;

    }



    private static string FormatNullableReceivedAt(DateTimeOffset? value)

    {

