@code {



    private readonly MentionFormModel _mentionForm = new();



    private readonly CommentListFormModel _commentListForm = new();



    private readonly UserPageFormModel _userPageForm = new();



    private readonly PostFormModel _postForm = new();



    private readonly CommentFormModel _commentForm = new();



    private readonly LikeFormModel _likeForm = new();



    private readonly DeleteCommentFormModel _deleteCommentForm = new();

    private readonly FinderHistoryFilterModel _historyFilter = new();

    private const int FinderHistoryExportCountPerType = 100;

    private static readonly IReadOnlyList<HistoryStatusOption> FinderHistoryStatusOptions = new List<HistoryStatusOption>

    {

        new("all", "全部"),

        new("success", "仅成功"),

        new("fail", "仅失败")

    };



    private IJSObjectReference? _finderInteropModule;



    private static readonly JsonSerializerOptions FinderExportJsonOptions = new()



    {



        WriteIndented = true,



        PropertyNamingPolicy = JsonNamingPolicy.CamelCase



    };







    private string _busyKey = string.Empty;



    private string _lastOperation = string.Empty;



    private string _lastMessage = string.Empty;



    private bool _lastSuccess = false;







    protected override async Task OnInitializedAsync()



    {



        Store.OnChange += HandleChange;



        Store.OnNotification += HandleNotification;



        if (!Store.Devices.Any())



        {



            await Store.InitializeAsync();



        }



    }







    public async ValueTask DisposeAsync()



    {



        Store.OnChange -= HandleChange;



        Store.OnNotification -= HandleNotification;







        if (_finderInteropModule != null)



        {



            try



            {



                await _finderInteropModule.DisposeAsync();



            }



            catch (JSDisconnectedException)



            {



                // 页面已断开时忽略模块释放异常。



            }



        }



    }







    private async void HandleChange()



    {



        await InvokeAsync(StateHasChanged);



    }







    private void HandleNotification(string message, bool success)



    {



        _ = InvokeAsync(() =>



        {



            NoticeService.Notify(new NotificationMessage



            {



                Severity = success ? NotificationSeverity.Success : NotificationSeverity.Error,



                Summary = success ? "成功" : "错误",



                Detail = message,



                Duration = 4000



            });



        });



    }







    private async Task OnDeviceChange(object item)



    {



        if (item is SrClient device)



        {



            await Store.SelectDeviceAsync(device);



        }



    }







    private string GetSelectedDeviceLabel()



    {



        var device = Store.SelectedDevice;



        if (device == null)



        {



            return "未选择设备";



        }







        var nick = device.wx?.wechatAccount?.nickname;



        if (!string.IsNullOrWhiteSpace(nick))



        {



            return $"{nick} ({device.uuid})";



        }







        return device.uuid;



    }







    private bool EnsureDeviceSelected(string operationName)



    {



        if (Store.SelectedDevice != null)



        {



            return true;



        }







        SetResult(operationName, false, "请先选择设备");



        return false;



    }







    private async Task RunBoolOperationAsync(string busyKey, string operationName, Func<Task<bool>> action)



    {



        if (!EnsureDeviceSelected(operationName))



        {



            return;



        }







        _busyKey = busyKey;



        try



        {



            var success = await action();



            SetResult(operationName, success, success ? "指令已提交，等待运行态结果。" : "指令下发失败。");



        }



        catch (Exception ex)



        {



