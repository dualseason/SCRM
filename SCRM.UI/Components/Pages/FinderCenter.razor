        }

    }



    private async Task ExportFinderHistoryAsync()

    {

        if (!EnsureDeviceSelected("导出视频号历史"))

        {

            return;

        }



        if (_historyFilter.ReceivedFrom.HasValue && _historyFilter.ReceivedTo.HasValue && _historyFilter.ReceivedFrom.Value > _historyFilter.ReceivedTo.Value)

        {

            SetResult("导出视频号历史", false, "开始时间不能晚于结束时间。");

            return;

        }



        _busyKey = "history-export";

        try

        {

            var exportModel = await Store.ExportFinderHistoryForSelectedDeviceAsync(
                FinderHistoryExportCountPerType,
                ResolveHistorySuccessFilter(),
                NormalizeHistoryTaskId(_historyFilter.TaskId),
                ResolveHistoryReceivedFrom(),
                ResolveHistoryReceivedTo());
            if (!exportModel.success)
            {
                SetResult("导出视频号历史", false, exportModel.message);
                return;
            }

            var json = JsonSerializer.Serialize(exportModel, FinderExportJsonOptions);

            var module = await GetFinderInteropModuleAsync();

            await module.InvokeVoidAsync("downloadTextFile", BuildFinderHistoryExportFileName(), json, "application/json;charset=utf-8");

            SetResult("导出视频号历史", true, exportModel.message);

        }

        catch (Exception ex)

        {

            SetResult("导出视频号历史", false, ex.Message);

        }

        finally

        {

            _busyKey = string.Empty;

        }

    }



    private async Task ReloadFinderHistoryWithCurrentFilterAsync()

    {

        await Store.ReloadFinderHistoryForSelectedDeviceAsync(

            ResolveHistorySuccessFilter(),

            NormalizeHistoryTaskId(_historyFilter.TaskId),

            ResolveHistoryReceivedFrom(),

            ResolveHistoryReceivedTo());

    }



    private async Task<IJSObjectReference> GetFinderInteropModuleAsync()

    {

        _finderInteropModule ??= await JS.InvokeAsync<IJSObjectReference>(

            "import",

            "./_content/SCRM.UI/finderCenterInterop.js");

        return _finderInteropModule;

    }



    private string BuildFinderHistoryExportFileName()

    {

        var deviceUuid = Store.SelectedDevice?.uuid ?? "unknown-device";

        foreach (var invalidChar in System.IO.Path.GetInvalidFileNameChars())

        {

            deviceUuid = deviceUuid.Replace(invalidChar, '_');

        }



        var suffix = _historyFilter.Status == "all" && !_historyFilter.TaskId.HasValue && !_historyFilter.ReceivedFrom.HasValue && !_historyFilter.ReceivedTo.HasValue

            ? "all"

            : "filtered";

        return $"finder-history-{deviceUuid}-{suffix}-{DateTimeOffset.UtcNow:yyyyMMdd_HHmmss}.json";

    }



    private bool? ResolveHistorySuccessFilter()

    {

        return _historyFilter.Status switch

        {

            "success" => true,

            "fail" => false,

            _ => null

        };

    }



    private static long? NormalizeHistoryTaskId(long? taskId)

    {

        return taskId.HasValue && taskId.Value > 0 ? taskId : null;

    }



    private DateTimeOffset? ResolveHistoryReceivedFrom()

    {

        return _historyFilter.ReceivedFrom.HasValue

            ? new DateTimeOffset(_historyFilter.ReceivedFrom.Value)

            : null;

    }



    private DateTimeOffset? ResolveHistoryReceivedTo()

    {

        return _historyFilter.ReceivedTo.HasValue

            ? new DateTimeOffset(_historyFilter.ReceivedTo.Value)

            : null;

    }



    private string GetFinderHistoryFilterSummary()

    {

        var parts = new List<string>();



        parts.Add(_historyFilter.Status switch

        {

            "success" => "状态=仅成功",

            "fail" => "状态=仅失败",

            _ => "状态=全部"

        });



        var taskId = NormalizeHistoryTaskId(_historyFilter.TaskId);

        if (taskId.HasValue)

        {

            parts.Add($"TaskId={taskId.Value}");

        }



        if (_historyFilter.ReceivedFrom.HasValue)

        {

            parts.Add($"开始={_historyFilter.ReceivedFrom.Value:yyyy-MM-dd HH:mm:ss}");

        }



        if (_historyFilter.ReceivedTo.HasValue)

        {

            parts.Add($"结束={_historyFilter.ReceivedTo.Value:yyyy-MM-dd HH:mm:ss}");

        }



        return $"当前筛选：{string.Join(" ｜ ", parts)}";

    }



    /// <summary>
    /// 表格中展示长文本时进行截断，完整内容保留在 title 中，避免视频号评论或引用内容撑开页面。
    /// </summary>
    private static string FormatShortText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        var trimmed = value.Trim();
        return trimmed.Length <= maxLength ? trimmed : trimmed[..maxLength] + "...";
    }



    private static string FormatReceivedAt(DateTimeOffset value)



    {



        return value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");



    }







    private static string FormatUnixSeconds(long value)



    {



        if (value <= 0)



        {



            return "-";



        }







        try



        {



            return DateTimeOffset.FromUnixTimeSeconds(value).ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");



        }



        catch



        {



            return value.ToString();



        }



    }







