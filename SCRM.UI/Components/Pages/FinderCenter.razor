    private async Task ApplyHistoryFilterAsync()

    {

        if (!EnsureDeviceSelected("筛选视频号历史"))

        {

            return;

        }



        if (_historyFilter.ReceivedFrom.HasValue && _historyFilter.ReceivedTo.HasValue && _historyFilter.ReceivedFrom.Value > _historyFilter.ReceivedTo.Value)

        {

            SetResult("筛选视频号历史", false, "开始时间不能晚于结束时间。");

            return;

        }



        _busyKey = "history-apply";

        try

        {

            await ReloadFinderHistoryWithCurrentFilterAsync();

            SetResult("筛选视频号历史", true, "已按当前筛选条件重新加载 Finder 历史。");

        }

        catch (Exception ex)

        {

            SetResult("筛选视频号历史", false, ex.Message);

        }

        finally

        {

            _busyKey = string.Empty;

        }

    }



    private async Task ClearHistoryFilterAsync()

    {

        if (!EnsureDeviceSelected("清空视频号历史筛选"))

        {

            _historyFilter.Reset();

