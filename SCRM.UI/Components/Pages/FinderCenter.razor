    }



    private List<FinderFailureSummaryItem> GetFinderFailureHistoryItems()

    {

        var items = new List<FinderFailureSummaryItem>();



        items.AddRange(Store.SelectedFinderMentionHistory

            .Where(item => !item.success)

            .Select(item => new FinderFailureSummaryItem

            {

                ResultTypeName = "提及列表",

                TaskId = item.taskId,

                ReceivedAt = item.receivedAt,

                Summary = $"视频号：{item.sphUserName} ｜ 赞/评/关：{item.likeList.Count}/{item.commentList.Count}/{item.followList.Count}",

                ErrorMessage = NormalizeFinderFailureMessage(item.errMsg)

            }));



        items.AddRange(Store.SelectedFinderUserPageHistory

            .Where(item => !item.success)

            .Select(item => new FinderFailureSummaryItem

            {

                ResultTypeName = "用户页",

                TaskId = item.taskId,

                ReceivedAt = item.receivedAt,

                Summary = $"视频号：{item.userName} ｜ 作品数：{item.sphList.Count}",

                ErrorMessage = NormalizeFinderFailureMessage(item.errMsg)

            }));



        items.AddRange(Store.SelectedFinderCommentHistory

            .Where(item => !item.success)

            .Select(item => new FinderFailureSummaryItem

            {

                ResultTypeName = "评论列表",

                TaskId = item.taskId,

                ReceivedAt = item.receivedAt,

                Summary = $"视频号：{item.sphUserName} ｜ 评论数：{item.commentList.Count}",

                ErrorMessage = NormalizeFinderFailureMessage(item.errMsg)

            }));



        return items

            .OrderByDescending(item => item.ReceivedAt)

            .ToList();

    }



    private static string NormalizeFinderFailureMessage(string? message)

    {

        return string.IsNullOrWhiteSpace(message) ? "未返回错误文案" : message.Trim();

    }



