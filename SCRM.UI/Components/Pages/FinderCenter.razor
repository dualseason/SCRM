@page "/finder"



@using System



@using Radzen



@using Radzen.Blazor



@using System.Linq



@using System.Text.Json



@using Microsoft.JSInterop



@using SCRM.API.Models.Entities



@using SCRM.SHARED.Models.Dtos



@using SCRM.UI.Services



@inject CrmStore Store



@inject NotificationService NoticeService



@inject IJSRuntime JS



@inject DialogService DialogService



@implements IAsyncDisposable







<PageTitle>视频号中心</PageTitle>







<RadzenRow Gap="0" Style="height: calc(100vh - 56px); margin: 0; background: var(--rz-base-100); overflow: hidden;">



    <RadzenColumn Size="3" SizeMD="2" Style="background: var(--rz-base-0); border-right: 1px solid var(--rz-border-color); overflow-y: auto;">



        <RadzenListBox Data="@Store.Devices" Value="@Store.SelectedDevice" TValue="SrClient"



                       Change="@(EventCallback.Factory.Create<object>(this, OnDeviceChange))"



                       Style="height: 100%; width: 100%; border: none; text-align: center; background-color: transparent;">



            <Template Context="device">



                @{



                    bool isDeviceOnline = device.isOnline;



                    bool isWxOnline = isDeviceOnline && (device.wx?.wechatAccount?.accountStatus == 1);



                    string dotColor = !isDeviceOnline ? "var(--rz-danger)" : (isWxOnline ? "var(--rz-success)" : "var(--rz-warning)");



                    string statusText = !isDeviceOnline ? "离线" : (isWxOnline ? "微信在线" : "设备在线");



                }



                <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="2px" Style="width: 100%; overflow: hidden; padding-top: 5px; padding-bottom: 5px;">



                    <div title="@(device.wx?.wechatAccount?.nickname ?? device.device?.PhoneModel ?? "Device")" style="position: relative; display: inline-block;">



                        @if (!string.IsNullOrEmpty(device.wx?.wechatAccount?.avatarUrl))



                        {



                            <RadzenImage Path="@(device.wx?.wechatAccount?.avatarUrl)" Style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover;" />



                        }



                        else



                        {



                            <RadzenIcon Icon="smartphone" Style="font-size: 24px; width: 40px; height: 40px; background-color: var(--rz-base-200); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--rz-text-secondary-color);" />



                        }



                        <span style="position: absolute; bottom: -2px; right: -2px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--rz-base-0); background-color: @dotColor;"></span>



                    </div>







                    <RadzenText TextStyle="TextStyle.Caption" Style="@($"font-size: 10px; line-height: 1.2; font-weight: bold; color: {dotColor}")">



                        @statusText



                    </RadzenText>







                    <RadzenText TextStyle="TextStyle.Caption"



                                Style="font-size: 10px; line-height: 1.2; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center;"



                                Text="@(string.IsNullOrEmpty(device.wx?.wechatAccount?.nickname) ? "未登录" : device.wx?.wechatAccount?.nickname)" />



                </RadzenStack>



            </Template>



        </RadzenListBox>



    </RadzenColumn>







    <RadzenColumn Size="9" SizeMD="10" Style="padding: 1rem; overflow-y: auto; height: 100%;">



        @if (Store.SelectedDevice == null)



        {



            <RadzenCard Class="rz-p-5 rz-text-align-center" Style="background: var(--rz-base-0); max-width: 720px; margin: 0 auto;">



                <RadzenIcon Icon="videocam" Style="font-size: 3rem; color: var(--rz-text-disabled-color);" />



                <RadzenText TextStyle="TextStyle.H6" Class="rz-mt-4">请选择一个设备以操作视频号能力</RadzenText>



            </RadzenCard>



        }



        else



        {



            <RadzenStack Gap="1rem" Style="max-width: 1080px; margin: 0 auto;">



                <OperationContextHint Title="视频号当前操作"
                                      Description="视频号任务按当前微信执行；如果微信换到另一台设备登录，请先在顶部或左侧切换执行设备。"
                                      Class="rz-mb-0" />

                <RadzenCard>



                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">



                        <div>



                            <RadzenText TextStyle="TextStyle.H5" Class="rz-mb-0">视频号中心</RadzenText>



                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">



                                当前设备：@GetSelectedDeviceLabel()



                            </RadzenText>



                        </div>



                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true" Style="margin: 0;">



                            `SphLikeTask / SphDelCommentTask` 当前安卓侧仍按 62203 口径显式返回“功能未实现”。
                            为避免继续表现为“点击无反应”，本页先将点赞 / 删评入口降级为只读提示，待 SmRun 底层能力真正补齐后再恢复下发。



                        </RadzenAlert>



                    </RadzenStack>



                </RadzenCard>







                @if (!string.IsNullOrWhiteSpace(_lastOperation))



                {



                    <RadzenAlert AlertStyle="@(_lastSuccess ? AlertStyle.Success : AlertStyle.Danger)" Variant="Variant.Flat" ShowIcon="true">



                        <b>@_lastOperation</b>



                        <div>@_lastMessage</div>



                    </RadzenAlert>



                }







                <RadzenTabs>



                    <Tabs>



                        <RadzenTabsItem Text="拉取任务" Icon="download">



                            <RadzenRow Gap="1rem">



                                <RadzenColumn Size="12" SizeLG="6">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">提及列表拉取</RadzenText>



                                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="LastLikeId" />



                                                    <RadzenNumeric @bind-Value="_mentionForm.LastLikeId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="LastCommentId" />



                                                    <RadzenNumeric @bind-Value="_mentionForm.LastCommentId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="LastFollowId" />



                                                    <RadzenNumeric @bind-Value="_mentionForm.LastFollowId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenButton Text="下发提及拉取"



                                                          Icon="send"



                                                          ButtonStyle="ButtonStyle.Primary"



                                                          IsBusy="@(_busyKey == "mention")"



                                                          Click="SendMentionAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>







                                <RadzenColumn Size="12" SizeLG="6">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">评论列表拉取</RadzenText>



                                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="FeedId" />



                                                    <RadzenNumeric @bind-Value="_commentListForm.FeedId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="RefCommentId" />



                                                    <RadzenNumeric @bind-Value="_commentListForm.RefCommentId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="ReplyCommentId" />



                                                    <RadzenNumeric @bind-Value="_commentListForm.ReplyCommentId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="SortType" />



                                                    <RadzenNumeric @bind-Value="_commentListForm.SortType" TValue="int?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="NonceId" />



                                                    <RadzenTextBox @bind-Value="_commentListForm.NonceId" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="FeedAuth" />



                                                    <RadzenTextBox @bind-Value="_commentListForm.FeedAuth" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenButton Text="下发评论列表拉取"



                                                          Icon="send"



                                                          ButtonStyle="ButtonStyle.Primary"



                                                          IsBusy="@(_busyKey == "comment-list")"



                                                          Click="SendCommentListAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>







                                <RadzenColumn Size="12">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">用户页拉取</RadzenText>



                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End" Class="rz-mt-3">



                                            <div style="min-width: 320px; flex: 1;">



                                                <RadzenLabel Text="SphUserName" />



                                                <RadzenTextBox @bind-Value="_userPageForm.SphUserName" Style="width: 100%;" />



                                            </div>



                                            <RadzenButton Text="下发用户页拉取"



                                                          Icon="send"



                                                          ButtonStyle="ButtonStyle.Primary"



                                                          IsBusy="@(_busyKey == "user-page")"



                                                          Click="SendUserPageAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>



                            </RadzenRow>



                        </RadzenTabsItem>







                        <RadzenTabsItem Text="发布 / 互动" Icon="forum">



                            <RadzenRow Gap="1rem">



                                <RadzenColumn Size="12" SizeLG="6">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">视频号发布</RadzenText>



                                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">



                                            <div>



                                                <RadzenLabel Text="Content" />



                                                <RadzenTextArea @bind-Value="_postForm.Content" Style="width: 100%; min-height: 96px;" />



                                            </div>



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="MediaType" />



                                                    <RadzenNumeric @bind-Value="_postForm.MediaType" TValue="int?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="8">



                                                    <RadzenLabel Text="Cover" />



                                                    <RadzenTextBox @bind-Value="_postForm.Cover" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <div>



                                                <RadzenLabel Text="Medias（每行一个路径/URL）" />



                                                <RadzenTextArea @bind-Value="_postForm.MediasText" Style="width: 100%; min-height: 120px;" />



                                            </div>



                                            <RadzenButton Text="下发发布任务"



                                                          Icon="send"



                                                          ButtonStyle="ButtonStyle.Primary"



                                                          IsBusy="@(_busyKey == "post")"



                                                          Click="SendPostAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>







                                <RadzenColumn Size="12" SizeLG="6">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">视频号评论</RadzenText>



                                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="FeedId" />



                                                    <RadzenNumeric @bind-Value="_commentForm.FeedId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="Type" />



                                                    <RadzenNumeric @bind-Value="_commentForm.Type" TValue="int?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="4">



                                                    <RadzenLabel Text="ReplyCommentId" />



                                                    <RadzenNumeric @bind-Value="_commentForm.ReplyCommentId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="NonceId" />



                                                    <RadzenTextBox @bind-Value="_commentForm.NonceId" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="FeedAuth" />



                                                    <RadzenTextBox @bind-Value="_commentForm.FeedAuth" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <div>



                                                <RadzenLabel Text="Content" />



                                                <RadzenTextArea @bind-Value="_commentForm.Content" Style="width: 100%; min-height: 96px;" />



                                            </div>



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="Media" />



                                                    <RadzenTextBox @bind-Value="_commentForm.Media" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="ReplyUsername" />



                                                    <RadzenTextBox @bind-Value="_commentForm.ReplyUsername" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenButton Text="下发评论任务"



                                                          Icon="send"



                                                          ButtonStyle="ButtonStyle.Primary"



                                                          IsBusy="@(_busyKey == "comment")"



                                                          Click="SendCommentAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>







                                <RadzenColumn Size="12" SizeLG="6">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">视频号点赞 / 取消点赞</RadzenText>



                                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="FeedId" />



                                                    <RadzenNumeric @bind-Value="_likeForm.FeedId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="Type" />



                                                    <RadzenNumeric @bind-Value="_likeForm.Type" TValue="int?" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenCheckBox @bind-Value="_likeForm.IsCancel" TValue="bool" />



                                            <RadzenLabel Text="是否取消点赞" Style="margin-top: -28px; margin-left: 32px;" />



                                            <RadzenButton Text="下发点赞任务"



                                                          Icon="thumb_up"



                                                          ButtonStyle="ButtonStyle.Warning"



                                                          IsBusy="@(_busyKey == "like")"
                                                          Disabled="true"



                                                          Click="SendLikeAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>







                                <RadzenColumn Size="12" SizeLG="6">



                                    <RadzenCard>



                                        <RadzenText TextStyle="TextStyle.Subtitle1">视频号删评</RadzenText>



                                        <RadzenStack Gap="0.75rem" Class="rz-mt-3">



                                            <RadzenRow Gap="1rem">



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="FeedId" />



                                                    <RadzenNumeric @bind-Value="_deleteCommentForm.FeedId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                                <RadzenColumn Size="12" SizeMD="6">



                                                    <RadzenLabel Text="CommentId" />



                                                    <RadzenNumeric @bind-Value="_deleteCommentForm.CommentId" TValue="long?" Style="width: 100%;" />



                                                </RadzenColumn>



                                            </RadzenRow>



                                            <RadzenButton Text="下发删评任务"



                                                          Icon="delete"



                                                          ButtonStyle="ButtonStyle.Danger"



                                                          IsBusy="@(_busyKey == "delete-comment")"
                                                          Disabled="true"



                                                          Click="SendDeleteCommentAsync" />



                                        </RadzenStack>



                                    </RadzenCard>



                                </RadzenColumn>



                            </RadzenRow>



                        </RadzenTabsItem>







                        <RadzenTabsItem Text="最近结果" Icon="analytics">



                            <RadzenStack Gap="1rem">



                                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true">



                                    当前页会按设备缓存最近 10 次视频号运行态回包；结果已落数据库，切换设备或服务重启后仍会自动恢复该设备自己的结果历史。



                                </RadzenAlert>







                                <RadzenCard Variant="Variant.Flat">



                                    <RadzenStack Gap="1rem">



                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">



                                            <div>



                                                <RadzenText TextStyle="TextStyle.Subtitle2">Finder 历史运维面</RadzenText>



                                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">



                                                    这里可以按状态 / TaskId / 时间范围从数据库重载当前设备最近 10 条 Finder 历史，并把筛选结果一次性导出为 JSON，用于 62203 回归复盘。



                                                </RadzenText>



                                            </div>



                                            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true" Style="margin: 0; min-width: 260px;">

                                                @GetFinderHistoryFilterSummary()

                                            </RadzenAlert>



                                        </RadzenStack>



                                        <RadzenRow Gap="1rem">

                                            <RadzenColumn Size="12" SizeLG="3">

                                                <RadzenLabel Text="状态筛选" />

                                                <RadzenDropDown Data="@FinderHistoryStatusOptions"

                                                                TextProperty="Label"

                                                                ValueProperty="Value"

                                                                @bind-Value="_historyFilter.Status"

                                                                TValue="string"

                                                                Style="width: 100%;" />

                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeLG="3">

                                                <RadzenLabel Text="TaskId" />

                                                <RadzenNumeric @bind-Value="_historyFilter.TaskId" TValue="long?" Style="width: 100%;" />

                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeLG="3">

                                                <RadzenLabel Text="开始时间" />

                                                <RadzenDatePicker @bind-Value="_historyFilter.ReceivedFrom"

                                                                  TValue="DateTime?"

                                                                  ShowTime="true"

                                                                  HourFormat="24"

                                                                  DateFormat="yyyy-MM-dd HH:mm:ss"

                                                                  Style="width: 100%;" />

                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeLG="3">

                                                <RadzenLabel Text="结束时间" />

                                                <RadzenDatePicker @bind-Value="_historyFilter.ReceivedTo"

                                                                  TValue="DateTime?"

                                                                  ShowTime="true"

                                                                  HourFormat="24"

                                                                  DateFormat="yyyy-MM-dd HH:mm:ss"

                                                                  Style="width: 100%;" />

                                            </RadzenColumn>

                                        </RadzenRow>



                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">



                                            <RadzenButton Text="按条件刷新"



                                                          Icon="filter_alt"



                                                          ButtonStyle="ButtonStyle.Primary"



                                                          IsBusy="@(_busyKey == "history-apply")"



                                                          Click="ApplyHistoryFilterAsync" />



                                            <RadzenButton Text="清空筛选"



                                                          Icon="filter_alt_off"



                                                          ButtonStyle="ButtonStyle.Light"



                                                          IsBusy="@(_busyKey == "history-clear")"



                                                          Click="ClearHistoryFilterAsync" />



                                            <RadzenButton Text="导出当前筛选 JSON"



                                                          Icon="download"



                                                          ButtonStyle="ButtonStyle.Secondary"



                                                          IsBusy="@(_busyKey == "history-export")"



                                                          Click="ExportFinderHistoryAsync" />



                                        </RadzenStack>



                                    </RadzenStack>



                                </RadzenCard>







                                <RadzenRow Gap="1rem">

                                    @{

                                        var mentionHistory = Store.SelectedFinderMentionHistory;

                                        var userPageHistory = Store.SelectedFinderUserPageHistory;

                                        var commentHistory = Store.SelectedFinderCommentHistory;

                                        var mentionSuccessCount = mentionHistory.Count(item => item.success);

                                        var mentionFailureCount = mentionHistory.Count - mentionSuccessCount;

                                        var mentionLatestReceivedAt = GetLatestReceivedAt(mentionHistory.Select(item => item.receivedAt));

                                        var userPageSuccessCount = userPageHistory.Count(item => item.success);

                                        var userPageFailureCount = userPageHistory.Count - userPageSuccessCount;

                                        var userPageLatestReceivedAt = GetLatestReceivedAt(userPageHistory.Select(item => item.receivedAt));

                                        var commentSuccessCount = commentHistory.Count(item => item.success);

                                        var commentFailureCount = commentHistory.Count - commentSuccessCount;

                                        var commentLatestReceivedAt = GetLatestReceivedAt(commentHistory.Select(item => item.receivedAt));

                                    }

                                    <RadzenColumn Size="12" SizeLG="4">

                                        <RadzenCard Variant="Variant.Flat">

                                            <RadzenText TextStyle="TextStyle.Caption">提及历史统计</RadzenText>

                                            <RadzenText TextStyle="TextStyle.H6">@mentionHistory.Count</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2">成功：@mentionSuccessCount ｜ 失败：@mentionFailureCount</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">最近时间：@FormatNullableReceivedAt(mentionLatestReceivedAt)</RadzenText>

                                        </RadzenCard>

                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeLG="4">

                                        <RadzenCard Variant="Variant.Flat">

                                            <RadzenText TextStyle="TextStyle.Caption">用户页历史统计</RadzenText>

                                            <RadzenText TextStyle="TextStyle.H6">@userPageHistory.Count</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2">成功：@userPageSuccessCount ｜ 失败：@userPageFailureCount</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">最近时间：@FormatNullableReceivedAt(userPageLatestReceivedAt)</RadzenText>

                                        </RadzenCard>

                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeLG="4">

                                        <RadzenCard Variant="Variant.Flat">

                                            <RadzenText TextStyle="TextStyle.Caption">评论历史统计</RadzenText>

                                            <RadzenText TextStyle="TextStyle.H6">@commentHistory.Count</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2">成功：@commentSuccessCount ｜ 失败：@commentFailureCount</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">最近时间：@FormatNullableReceivedAt(commentLatestReceivedAt)</RadzenText>

                                        </RadzenCard>

                                    </RadzenColumn>

                                </RadzenRow>



                                <RadzenCard Variant="Variant.Flat">

                                    <RadzenStack Gap="0.75rem">

                                        <div>

                                            <RadzenText TextStyle="TextStyle.Subtitle2">当前筛选失败摘要</RadzenText>

                                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">

                                                这里汇总当前设备在当前筛选条件下的全部失败 Finder 历史，方便先定位失败面，再回看具体结果。

                                            </RadzenText>

                                        </div>

                                        @{

                                            var failureItems = GetFinderFailureHistoryItems();

                                        }

                                        @if (!failureItems.Any())

                                        {

                                            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" ShowIcon="true">

                                                当前筛选范围内暂无失败记录。

                                            </RadzenAlert>

                                        }

                                        else

                                        {

                                            <div style="overflow-x: auto;">

                                                <table style="width: 100%; border-collapse: collapse;">

                                                    <thead>

                                                        <tr style="background: var(--rz-base-200);">

                                                            <th style="text-align:left; padding:8px;">类型</th>

                                                            <th style="text-align:left; padding:8px;">时间</th>

                                                            <th style="text-align:left; padding:8px;">TaskId</th>

                                                            <th style="text-align:left; padding:8px;">摘要</th>

                                                            <th style="text-align:left; padding:8px;">错误信息</th>

                                                        </tr>

                                                    </thead>

                                                    <tbody>

                                                        @foreach (var item in failureItems)

                                                        {

                                                            <tr style="border-top: 1px solid var(--rz-border-color);">

                                                                <td style="padding:8px;">@item.ResultTypeName</td>

                                                                <td style="padding:8px;">@FormatReceivedAt(item.ReceivedAt)</td>

                                                                <td style="padding:8px;">@item.TaskId</td>

