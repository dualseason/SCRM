    private async Task RunTaskResultOperationAsync(string busyKey, string operationName, Func<Task<TaskResult>> action)



    {



        if (!EnsureDeviceSelected(operationName))



        {



            return;



        }

        var confirm = await DialogService.Confirm(
            $"将通过【{Store.CurrentExecutionLabel}】执行：{operationName}。\n\n如果微信已换设备登录，请先在顶部或左侧切换执行设备。",
            operationName,
            new ConfirmOptions { OkButtonText = "确定执行", CancelButtonText = "取消" });
        if (confirm != true)
        {
            return;
        }







        _busyKey = busyKey;



        try



        {



            var result = await action();



            SetResult(operationName, result.success, string.IsNullOrWhiteSpace(result.message) ? (result.success ? "指令已提交。" : "指令执行失败。") : result.message);



        }



        catch (Exception ex)



        {



            SetResult(operationName, false, ex.Message);



        }



        finally



        {



            _busyKey = string.Empty;



        }



    }







    private void SetResult(string operationName, bool success, string message)



    {



        _lastOperation = operationName;



        _lastSuccess = success;



        _lastMessage = message;



        StateHasChanged();



    }







