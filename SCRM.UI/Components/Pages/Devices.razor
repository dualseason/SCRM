@page "/devices"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using SCRM.SHARED.Models.Dtos
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject NotificationService NoticeService
@implements IDisposable

<PageTitle>设备管理</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H5">设备列表</RadzenText>
    
    <RadzenDataList Data="@Store.Devices" TItem="SrClient" AllowPaging="true" PageSize="10" WrapItems="true">
        <Template Context="device">
            <RadzenCard Style="width: 100%; max-width: 400px; margin-bottom: 1rem;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        @if (!string.IsNullOrEmpty(device.weChatId))
                        {
                            <RadzenIcon Icon="wechat" IconColor="@Colors.Success" />
                            <RadzenText TextStyle="TextStyle.Subtitle2">@device.weChatNick</RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="color: var(--rz-danger)">未登录</RadzenText>
                        }
                    </RadzenStack>
                    <RadzenBadge BadgeStyle="@(device.isOnline ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(device.isOnline ? "在线" : "离线")" />
                </RadzenStack>
                
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); margin-top: 0.5rem;">UUID: @device.uuid</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color)">在线时间: @(device.lastLoginAt?.ToString("yyyy-MM-dd HH:mm:ss"))</RadzenText>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="margin-top: 1rem;">
                    <RadzenButton Text="管理" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => SelectDevice(device))" />
                    <RadzenButton Icon="camera_alt" Text="截屏" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" Click="@(() => CaptureScreen(device))" />
                </RadzenStack>
            </RadzenCard>
        </Template>
    </RadzenDataList>
</RadzenStack>

@if(Store.SelectedDevice != null) {
  <RadzenCard Style="margin-top: 20px;">
       <RadzenText TextStyle="TextStyle.H6">设备控制: @(Store.SelectedDevice.weChatNick ?? "未登录")</RadzenText>
       <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Style="margin-top: 1rem;">
           <RadzenButton Icon="camera_alt" Text="截屏" ButtonStyle="ButtonStyle.Primary" Click="@(() => CaptureScreen(Store.SelectedDevice))" />
           <RadzenButton Icon="sync" Text="同步联系人" ButtonStyle="ButtonStyle.Secondary" Click="@Store.SyncContactsAsync" />
       </RadzenStack>
       
       @if(!string.IsNullOrEmpty(Store.LastScreenShotUrl)) {
           <div style="margin-top:1rem;">
               <RadzenText TextStyle="TextStyle.Subtitle2">最新截屏:</RadzenText>
               <RadzenImage Path="@Store.LastScreenShotUrl" Style="width: 100%; max-width: 300px; margin-top: 0.5rem; border: 1px solid #eee;" />
           </div>
       }
  </RadzenCard>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleChange;
        Store.OnNotification += HandleNotification;
        await Store.InitializeAsync();
    }

    private async void HandleChange()
    {
        await InvokeAsync(StateHasChanged);
    } 

    public void Dispose()
    {
        Store.OnChange -= HandleChange;
        Store.OnNotification -= HandleNotification;
    }

    private void SelectDevice(SrClient dev)
    {
        _ = Store.SelectDeviceAsync(dev);
    }

    private async Task CaptureScreen(SrClient dev)
    {
        if (Store.SelectedDevice?.uuid != dev.uuid)
        {
            await Store.SelectDeviceAsync(dev);
        }
        await Store.RequestScreenShotAsync(dev.uuid);
    }
    
    private void HandleNotification(string msg, bool success)
    {
        _ = InvokeAsync(() => {
            NoticeService.Notify(new NotificationMessage
            {
                Severity = success ? NotificationSeverity.Success : NotificationSeverity.Error,
                Summary = success ? "成功" : "错误",
                Detail = msg,
                Duration = 4000
            });
        });
    }
}
