@page "/settings/{AccountId:long}"
@using SCRM.UI.Services
@using SCRM.SHARED.Models
@using Radzen
@using Radzen.Blazor
@inject ICrmService CrmService
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H4">账号自动化设置 (Automation Settings)</RadzenText>

    @if (isLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenCard>
            <RadzenStack Gap="1.5rem">
                <RadzenFieldset Text="红包助手 (Red Packet Assistant)">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenLabel Text="自动抢红包 (Auto Accept)" Component="AutoAcceptLuckyMoney" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                                <RadzenSwitch @bind-Value=@settings.AutoAcceptLuckyMoney Name="AutoAcceptLuckyMoney" />
                                <RadzenText TextStyle="TextStyle.Caption">开启后将自动领取接收到的个人和群红包。</RadzenText>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenFieldset Text="好友管理 (Friend Management)">
                    <RadzenStack Gap="1rem">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="自动通过好友请求 (Auto Accept Friend)" Component="AutoAcceptFriendRequest" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@settings.AutoAcceptFriendRequest Name="AutoAcceptFriendRequest" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="自动回复内容 (Auto Reply Content)" Component="AutoReplyContent" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenTextBox @bind-Value=@settings.AutoReplyContent Name="AutoReplyContent" Style="width: 100%;" />
                                <RadzenText TextStyle="TextStyle.Caption">留空则不自动回复。</RadzenText>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenFieldset>
                
                <RadzenFieldset Text="朋友圈 (Moments)">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenLabel Text="自动点赞 (Auto Like)" Component="AutoLikeMoments" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenSwitch @bind-Value=@settings.AutoLikeMoments Name="AutoLikeMoments" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
                    <RadzenButton Text="保存配置" Icon="save" ButtonStyle="ButtonStyle.Primary" Click=@SaveSettings />
                    <RadzenButton Text="返回" ButtonStyle="ButtonStyle.Light" Click=@(() => Navigation.NavigateTo("/")) />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Parameter]
    public long AccountId { get; set; }

    private WechatAccountSettings settings = new WechatAccountSettings();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            settings = await CrmService.GetAccountSettingsAsync(AccountId);
        }
        catch (Exception ex)
        {
             NotificationService.Notify(NotificationSeverity.Error, "加载失败", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            bool success = await CrmService.UpdateAccountSettingsAsync(AccountId, settings);
            if (success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "保存成功", "配置已更新");
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "保存失败", "数据库操作失败");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "保存异常", ex.Message);
        }
    }
}
