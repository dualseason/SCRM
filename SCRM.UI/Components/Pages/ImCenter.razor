@page "/im"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using SCRM.SHARED.Models.Dtos
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject NavigationManager NavManager
@inject NotificationService NoticeService
@inject DialogService DialogService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>SCRM Unified IM</PageTitle>

<style>
    .chat-bubble-self {
        background-color: #95ec69;
        border: 1px solid #7cd958;
    }
    .chat-bubble-other {
        background-color: #fff;
        border: 1px solid #e8e8e8;
    }
    /* Device status dot style */
    .device-status-dot {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 2px solid white;
    }
    /* Simple hover effect for listbox items if needed */
    .rz-listbox-item {
        padding: 5px !important;
        justify-content: center;
    }
</style>

<RadzenSplitter Orientation="Orientation.Horizontal" Style="height: calc(100vh - 60px); border: 1px solid var(--rz-border-color);">
    
    @* Pane 1: Device List (KISS: Direct Implementation) *@
    <RadzenSplitterPane Size="80px" Min="70px" Max="100px" Style="border-right: 1px solid var(--rz-border-color);">
        <RadzenListBox Data="@Store.Devices" Value="@Store.SelectedDevice" TValue="SrClient"
                       Change="@(EventCallback.Factory.Create<object>(this, OnDeviceChange))"
                       Style="height: 100%; width: 100%; border: none; text-align: center;">
            <Template Context="device">
                <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Gap="2px" Style="width: 100%; overflow: hidden; padding-top: 5px; padding-bottom: 5px; position: relative;">
                    @* Device Icon/Avatar - Click to Open Control/Details *@
                    <div title="@(device.wx?.wechatAccount?.nickname ?? device.device?.PhoneModel ?? "Device")" 
                         style="position: relative; display: inline-block; cursor: pointer;"
                         @onclick:stopPropagation="true" 
                         @onclick="@(() => OpenDeviceControl(device))">
                        
                        @if (!string.IsNullOrEmpty(device.wx?.wechatAccount?.avatarUrl))
                        {
                            <RadzenImage Path="@device.wx?.wechatAccount?.avatarUrl" Style="width: 40px; height: 40px; border-radius: 6px; object-fit: cover;" />
                        }
                        else
                        {
                            <RadzenIcon Icon="smartphone" Style="font-size: 24px; width: 40px; height: 40px; background-color: #f0f0f0; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #999;" />
                        }
                        
                        @{
                            bool isWxOnline = ((SrClient)device).wx?.wechatAccount != null ;
                            string dotColor = isWxOnline ? "#52c41a" : (device.isOnline ? "#faad14" : "#ff4d4f");
                        }
                        <span class="device-status-dot" style="background-color: @dotColor;"></span>
                    </div>

                    <RadzenText TextStyle="TextStyle.Caption" Style="@($"font-size: 10px; line-height: 1.2; font-weight: bold; color: {(device.isOnline ? "#52c41a" : "#ff4d4f")}")">
                        @(device.isOnline ? "在线" : "离线")
                    </RadzenText>

                    <RadzenText TextStyle="TextStyle.Caption" Style="font-size: 10px; line-height: 1.2; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center;" 
                                Text="@(string.IsNullOrEmpty(device.wx?.wechatAccount?.nickname) ? (string.IsNullOrEmpty(device.wx?.wechatAccount?.wxid ?? device.weChatId) ? "未登录" : $"未知微信号({device.wx?.wechatAccount?.wxid ?? device.weChatId})") : device.wx?.wechatAccount?.nickname)" />
                </RadzenStack>
            </Template>
        </RadzenListBox>
    </RadzenSplitterPane>

    @* Pane 2: Session/Contact List (300px) *@
    <RadzenSplitterPane Size="300px" Min="250px" Max="400px" Style="border-right: 1px solid var(--rz-border-color);">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="height: 100%;">
            
            @* Custom Text Tabs *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceAround" 
                         Style="height: 48px; border-bottom: 1px solid var(--rz-border-color); background: #fff;">
                <div @onclick="@(() => _activeTab = "chats")" 
                     style="@($"cursor: pointer; font-weight: 500; font-size: 14px; padding: 10px 0; color: {(_activeTab == "chats" ? "var(--rz-primary)" : "#666")}; border-bottom: 2px solid {(_activeTab == "chats" ? "var(--rz-primary)" : "transparent")}")">
                    会话
                </div>
                <div @onclick="@(() => _activeTab = "contacts")" 
                     style="@($"cursor: pointer; font-weight: 500; font-size: 14px; padding: 10px 0; color: {(_activeTab == "contacts" ? "var(--rz-primary)" : "#666")}; border-bottom: 2px solid {(_activeTab == "contacts" ? "var(--rz-primary)" : "transparent")}")">
                    通讯录
                </div>
                <div @onclick="@(() => _activeTab = "groups")" 
                     style="@($"cursor: pointer; font-weight: 500; font-size: 14px; padding: 10px 0; color: {(_activeTab == "groups" ? "var(--rz-primary)" : "#666")}; border-bottom: 2px solid {(_activeTab == "groups" ? "var(--rz-primary)" : "transparent")}")">
                    群聊
                </div>
            </RadzenStack>

            @* Search & Actions *@
            <RadzenStack Orientation="Orientation.Vertical" Gap="8px" Style="padding: 10px; border-bottom: 1px solid var(--rz-border-color); background: #f9f9f9;">
                <RadzenTextBox Placeholder="搜索" @bind-Value="_searchText" Change="@(args => OnSearchContact())" Style="width: 100%; height: 32px; font-size: 13px; border-radius: 4px;" />
                
                <RadzenStack Orientation="Orientation.Horizontal" Gap="5px">
                     <RadzenButton Text="一键群发" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" Style="flex: 1; color: #666;" Disabled="true" />
                     <RadzenButton Text="群发未读" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" Style="flex: 1; color: #666;" Disabled="true" />
                </RadzenStack>
            </RadzenStack>

            @* Content List *@
            <div style="flex: 1; overflow-y: auto;">
                @if (_activeTab == "chats")
                {
                     @if (Store.SelectedDevice == null)
                     {
                         <div class="rz-p-4 rz-text-align-center text-muted">请选择设备</div>
                     }
                     else if (Store.Conversations.Count == 0)
                     {
                         <div class="rz-p-4 rz-text-align-center text-muted">暂无会话</div>
                     }
                     else
                     {
                         <RadzenListBox Data="@Store.Conversations" Value="@Store.SelectedConversation" 
                                        TValue="Conversation" SelectedItemsText="Selected"
                                        Change="@(EventCallback.Factory.Create<object>(this, OnConversationChange))"
                                        Style="width: 100%; border: none;">
                             <Template Context="conv">
                                 <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" Style="padding: 8px 0;">
                                     <RadzenImage Path="@conv.displayAvatar" Style="width: 40px; height: 40px; border-radius: 4px;" />
                                     <RadzenStack Orientation="Orientation.Vertical" Gap="2px" Style="overflow: hidden; flex: 1;">
                                         <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                             <RadzenText Text="@conv.displayName" TextStyle="TextStyle.Body2" Style="font-weight: 500; color: #333;" />
                                             <RadzenText Text="@FormatDate(conv.lastMessageTime)" TextStyle="TextStyle.Caption" Style="color: #999; font-size: 11px;" />
                                         </RadzenStack>
                                         <RadzenText Text="@(conv.conversationType == 2 ? "[群] " + conv.lastMessageContent : conv.lastMessageContent)" 
                                                     TextStyle="TextStyle.Caption" Style="color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12px;" />
                                     </RadzenStack>
                                     @if (conv.unreadCount > 0)
                                     {
                                         <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@(conv.unreadCount > 99 ? "99+" : conv.unreadCount.ToString())" />
                                     }
                                 </RadzenStack>
                             </Template>
                         </RadzenListBox>
                     }
                }
                else if (_activeTab == "contacts" || _activeTab == "groups")
                {
                     @if (Store.SelectedDevice == null)
                     {
                         <div class="rz-p-4 rz-text-align-center text-muted">请选择设备</div>
                     }
                     @* else if (Store.Contacts.Count == 0) *@
                     else if (Store.SelectedDevice.wx?.contacts?.Count==0)

                     {
                         <div class="rz-p-4 rz-text-align-center">
                            <RadzenButton Text="同步联系人" ButtonStyle="ButtonStyle.Secondary" Click="SyncContacts" Size="ButtonSize.Small" />
                         </div>
                     }
                     else
                     {
                         <RadzenListBox Data="@_filteredContacts" Value="@Store.SelectedContact"
                                        TValue="Contact"
                                        Change="@(EventCallback.Factory.Create<object>(this, OnContactChange))"
                                        Style="width: 100%; border: none;">
                             <Template Context="contact">
                                 <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px" Style="padding: 8px 0;">
                                     <RadzenImage Path="@(string.IsNullOrEmpty(contact.avatar) ? "images/default-avatar.png" : contact.avatar)" 
                                                  Style="width: 36px; height: 36px; border-radius: 4px;" />
                                     <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                                         <RadzenText Text="@(string.IsNullOrEmpty(contact.remarks) ? contact.nickname : contact.remarks)" 
                                                     TextStyle="TextStyle.Body2" Style="font-weight: 500; color: #333;" />
                                         <RadzenText Text="@contact.nickname" TextStyle="TextStyle.Caption" Style="color: #999;" />
                                     </RadzenStack>
                                 </RadzenStack>
                             </Template>
                         </RadzenListBox>
                     }
                }
            </div>

        </RadzenStack>
    </RadzenSplitterPane>

    @* Pane 3: Chat Content *@
    <RadzenSplitterPane>
        <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="height: 100%; background: #f5f5f5;">
             @if (Store.SelectedDevice == null && Store.SelectedContact == null && Store.SelectedConversation == null)
             {
                 <!-- Empty State -->
                 <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%;">
                     <RadzenIcon Icon="chat_bubble_outline" Style="font-size: 4rem; color: #ccc;" />
                     <RadzenText Text="请选择会话开始聊天" TextStyle="TextStyle.Body1" Style="color: #ccc; margin-top: 10px;" />
                 </RadzenStack>
             }
             else
             {
                 <!-- Chat Header -->
                 <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" 
                              Style="height: 50px; padding: 0 1rem; border-bottom: 1px solid #e0e0e0; background: #fff;">
                     <RadzenText Text="@(Store.SelectedContact?.remarks ?? Store.SelectedContact?.nickname ?? Store.SelectedConversation?.displayName ?? "Unknown")" 
                                 TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 600;" />
                     <RadzenButton Icon="more_horiz" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Medium" />
                 </RadzenStack>

                 <!-- Chat Messages -->
                 <div id="chat-box" class="rz-p-4" style="flex: 1; overflow-y: auto;">
                     <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                        @foreach (var msg in Store.CurrentMessages)
                        {
                            <div style="display: flex; width: 100%; justify-content: @(msg.direction == 1 ? "flex-end" : "flex-start");">
                                @if (msg.direction != 1)
                                {
                                    <RadzenImage Path="@(ContextAvatar())" Style="width:36px; height:36px; border-radius: 4px; margin-right: 10px;" />
                                }

                                <div style="max-width: 70%; padding: 8px 12px; border-radius: 4px; position: relative; font-size: 14px; line-height: 1.5;
                                            background-color: @(msg.direction == 1 ? "#95ec69" : "#fff"); border: @(msg.direction == 1 ? "none" : "1px solid #eee");">
                                    @msg.content
                                    @if (msg.sendStatus == 1)
                                    {
                                        <RadzenIcon Icon="sync" Style="font-size: 12px; margin-left: 8px; animation: rz-spin 1s infinite linear;" />
                                    }
                                </div>

                                @if (msg.direction == 1)
                                {
                                    <RadzenImage Path="@(Store.SelectedDevice?.wx?.wechatAccount?.avatarUrl ?? "images/default-avatar.png")" Style="width:36px; height:36px; border-radius: 4px; margin-left: 10px;" />
                                }
                            </div>
                        }
                        <div id="scroll-anchor"></div>
                     </RadzenStack>
                 </div>

                 <!-- Chat Input Area -->
                 <div style="background: #fff; border-top: 1px solid #e0e0e0; padding: 0;">
                     <!-- Toolbar -->
                     <RadzenStack Orientation="Orientation.Horizontal" Gap="15px" Style="padding: 10px 15px; border-bottom: 1px solid #f0f0f0;">
                         <RadzenIcon Icon="sentiment_satisfied_alt" Style="cursor: pointer; color: #666; font-size: 20px;" />
                         <RadzenIcon Icon="folder_open" Style="cursor: pointer; color: #666; font-size: 20px;" />
                         <RadzenIcon Icon="image" Style="cursor: pointer; color: #666; font-size: 20px;" />
                         <RadzenIcon Icon="content_cut" Style="cursor: pointer; color: #666; font-size: 20px;" Click="CaptureScreen" />
                         <RadzenIcon Icon="history" Style="cursor: pointer; color: #666; font-size: 20px;" />
                     </RadzenStack>

                     <!-- TextArea -->
                     <RadzenTextArea @bind-Value="_msgContent" Rows="4" Style="width: 100%; border: none; box-shadow: none; padding: 10px 15px; resize: none;" 
                                   Placeholder="请输入内容..." @onkeydown="HandleKeyPress" />
                     
                     <!-- Footer Send Button -->
                     <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="padding: 5px 15px 10px;">
                         <RadzenText Text="按Ctrl + Enter换行" TextStyle="TextStyle.Caption" Style="color: #999;" />
                         <RadzenButton Text="发送 (Enter)" Click="Send" IsBusy="@_sending" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Style="padding-left: 20px; padding-right: 20px;" />
                     </RadzenStack>
                 </div>
             }
        </RadzenStack>
    </RadzenSplitterPane>

    @* Pane 4: Right Sidebar (Knowledge Base) *@
    <RadzenSplitterPane Size="250px" Collapsible="true" Style="border-left: 1px solid var(--rz-border-color);">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="height: 100%; background: #fff;">
            <!-- Simple Tab Header -->
             <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceAround" 
                         Style="height: 48px; border-bottom: 1px solid #e0e0e0; background: #fafafa;">
                <div style="cursor: pointer; font-weight: 500; font-size: 14px; padding: 10px 0; color: var(--rz-primary); border-bottom: 2px solid var(--rz-primary);">
                    公共话术
                </div>
                <div style="cursor: pointer; font-weight: 500; font-size: 14px; padding: 10px 0; color: #666;">
                    信息管理
                </div>
            </RadzenStack>

            <!-- Search -->
            <div style="padding: 10px; border-bottom: 1px solid #f0f0f0;">
                <RadzenTextBox Placeholder="请输入内容" Style="width: 100%; height: 30px; font-size: 12px;" />
            </div>

            <!-- Accordion Content -->
            <div style="flex: 1; overflow-y: auto;">
                <RadzenAccordion Multiple="true">
                    <Items>
                        <RadzenAccordionItem Text="文本" Icon="text_fields" Selected="true">
                             <div class="rz-p-2" style="font-size: 12px; color: #666;">暂无文本话术</div>
                        </RadzenAccordionItem>
                        <RadzenAccordionItem Text="笑话一则" Icon="mood">
                             <div class="rz-p-2" style="font-size: 12px; color: #666;">暂无内容</div>
                        </RadzenAccordionItem>
                        <RadzenAccordionItem Text="产品介绍" Icon="description">
                             <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="padding: 5px 0; border-bottom: 1px dashed #eee;">
                                 <span style="font-size: 12px;">语音文件</span>
                                 <RadzenIcon Icon="send" Style="font-size: 14px; color: #999; cursor: pointer;" />
                             </RadzenStack>
                        </RadzenAccordionItem>
                        <RadzenAccordionItem Text="文件" Icon="attach_file">
                             <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="padding: 5px 0; border-bottom: 1px dashed #eee;">
                                 <span style="font-size: 12px;">xlsx文件测试</span>
                                 <RadzenIcon Icon="send" Style="font-size: 14px; color: #999; cursor: pointer;" />
                             </RadzenStack>
                        </RadzenAccordionItem>
                        <RadzenAccordionItem Text="图片" Icon="image">
                             <div class="rz-p-2" style="font-size: 12px; color: #666;">暂无图片</div>
                        </RadzenAccordionItem>
                    </Items>
                </RadzenAccordion>
            </div>
        </RadzenStack>
    </RadzenSplitterPane>
</RadzenSplitter>

@code {
    private string _msgContent = "";
    private string _searchText = "";
    private bool _sending = false;
    private string _activeTab = "chats";

    // Helper to get avatar for current chat context
    private string ContextAvatar()
    {
        if (Store.SelectedContact != null) return Store.SelectedContact.avatar ?? "images/default-avatar.png";
        if (Store.SelectedConversation != null) return Store.SelectedConversation.displayAvatar ?? "images/default-avatar.png";
        return "images/default-avatar.png";
    }

    // private List<Contact> _filteredContacts => string.IsNullOrWhiteSpace(_searchText)
    //     ? Store.Contacts
    //     : Store.Contacts.Where(c => (c.nickname?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
    //                              || (c.remarks?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        private List<Contact> _filteredContacts
    {
        get
        {
            // 1. 获取当前选中设备的 wx 对象中的联系人列表
            // 如果 SelectedDevice 为空、wx 为空或 contacts 为空，则使用空列表，防止空引用报错
            var source = Store.SelectedDevice?.wx?.contacts ?? new List<Contact>();
            // 2. 根据搜索框内容进行过滤
            return string.IsNullOrWhiteSpace(_searchText)
                ? source
                : source.Where(c => (c.nickname?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                                 || (c.remarks?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleStoreChange;
        Store.OnNotification += HandleStoreNotification;

        await Store.InitializeAsync();

        // Auto-select first device if available
        if (Store.SelectedDevice == null && Store.Devices.Count > 0)
        {
            await SelectDevice(Store.Devices.First());
        }
    }

    public void Dispose()
    {
        Store.OnChange -= HandleStoreChange;
        Store.OnNotification -= HandleStoreNotification;
    }

    private void HandleStoreChange()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await ScrollToBottom();
        });
    }

    private void HandleStoreNotification(string msg, bool success)
    {
        InvokeAsync(() => HandleNotification(msg, success));
    }

    private async Task OnDeviceSelectedInternal(SrClient device)
    {
        await SelectDevice(device);
    }

    private async Task SelectDevice(SrClient device)
    {
        await Store.SelectDeviceAsync(device);
    }

    private async Task SelectContact(Contact contact)
    {
        // Null check handled by Change event logic mostly, but good to have
        if (contact != null) 
            await Store.SelectContactAsync(contact);
    }

    private async Task SelectConversation(Conversation conv)
    {
        if (conv != null)
            await Store.SelectConversationAsync(conv);
    }

    private async Task RefreshDevices()
    {
        await Store.LoadDevicesAsync();
        NoticeService.Notify(NotificationSeverity.Success, "Refreshed");
    }

    private async Task SyncContacts()
    {
        if (Store.SelectedDevice == null) return;
        await Store.SyncContactsAsync();
        NoticeService.Notify(NotificationSeverity.Info, "Sync Command Sent");
    }

    private void OnSearchContact()
    {
        StateHasChanged();
    }

    private void GoToMoments()
    {
        NavManager.NavigateTo("/moments");
    }

    private async Task CaptureScreen()
    {
        if (Store.SelectedDevice == null) return;
        await Store.RequestScreenShotAsync(Store.SelectedDevice.uuid);
        NoticeService.Notify(NotificationSeverity.Info, "Screenshot Requested");
    }

    private async Task OpenDeviceControl(SrClient? device = null)
    {
        var target = device ?? Store.SelectedDevice;
        if (target == null) return;
        
        await DialogService.OpenAsync<SCRM.UI.Components.Dialogs.DeviceControlDialog>(
            $"Device Control: {target?.wx?.wechatAccount?.nickname}",
            new Dictionary<string, object>() { { "Device", target } },
            new DialogOptions() { Width = "700px", Height = "auto", Resizable = true, Draggable = true });
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_msgContent) || Store.SelectedDevice == null || (Store.SelectedContact == null && Store.SelectedConversation == null)) return;

        _sending = true;
        var result = await Store.SendMessageAsync(_msgContent);
        if (result)
        {
            _msgContent = "";
        }
        else
        {
            NoticeService.Notify(NotificationSeverity.Error, "Failed to send");
        }
        _sending = false;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.CtrlKey && (e.Key == "Enter" || e.Key == "NumpadEnter"))
        {
            await Send();
        }
    }

    private async Task DeleteFriend_Click()
    {
        if (Store.SelectedDevice == null || Store.SelectedContact == null) return;

        var result = await DialogService.Confirm("Are you sure delete this friend?", "Delete Friend", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (result == true)
        {
            await Store.DeleteFriendAsync(Store.SelectedContact.wxid);
            NoticeService.Notify(NotificationSeverity.Success, "Delete Command Sent");
        }
    }

    private void HandleNotification(string msg, bool success)
    {
        NoticeService.Notify(success ? NotificationSeverity.Success : NotificationSeverity.Error, success ? "Success" : "Error", msg);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('chat-box'); if(el) el.scrollTop = el.scrollHeight;");
        }
        catch { }
    }

    private string FormatDate(DateTime dt)
    {
        if (dt.Date == DateTime.Today)
            return dt.ToString("HH:mm");
        if (dt.Date == DateTime.Today.AddDays(-1))
            return "Yesterday";
        if (dt.Year == DateTime.Now.Year)
            return dt.ToString("MM-dd");
        return dt.ToString("yyyy-MM-dd");
    }

    private async Task OnDeviceChange(object value)
    {
        if (value is SrClient device)
        {
            await SelectDevice(device);
        }
    }

    private async Task OnConversationChange(object value)
    {
        if (value is Conversation conv)
        {
            await SelectConversation(conv);
        }
    }

    private async Task OnContactChange(object value)
    {
        if (value is Contact contact)
        {
            await SelectContact(contact);
        }
    }
}
