@page "/im"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using SCRM.SHARED.Models.Dtos
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject NavigationManager NavManager
@inject NotificationService NoticeService
@inject DialogService DialogService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>SCRM Unified IM</PageTitle>

<RadzenRow Gap="0" Style="height: calc(100vh - 60px); border: 1px solid var(--rz-border-color); margin: 0; background: var(--rz-base-100);">

    @* Pane 1: Device List *@
    <RadzenColumn Size="1" SizeMD="1" Style="border-right: 1px solid var(--rz-border-color); padding: 0;">
        <ImCenterDevicePane />
    </RadzenColumn>

    @* Pane 2: Session/Contact List *@
    <RadzenColumn Size="3" SizeMD="3" Style="border-right: 1px solid var(--rz-border-color); padding: 0; display: flex; flex-direction: column;">
        <ImCenterSessionPane @bind-ActiveTab="Store.ActiveImTab" />
    </RadzenColumn>

    @* Pane 3: Chat Content *@
    <RadzenColumn Size="5" SizeMD="5" Style="padding: 0; display: flex; flex-direction: column; overflow: hidden; min-height: 0;">
        <ImCenterChatPane @bind-ActiveTab="Store.ActiveImTab" />
    </RadzenColumn>

    @* Pane 4: Right Sidebar (Knowledge Base) *@
    <RadzenColumn Size="3" SizeMD="3" Style="border-left: 1px solid var(--rz-border-color); padding: 0; display: flex; flex-direction: column;">
        <ImCenterInfoPane />
    </RadzenColumn>

</RadzenRow>

@code {
    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleStoreChange;
        await Store.InitializeAsync();

        if (Store.SelectedDevice == null && Store.Devices.Count > 0)
        {
            await Store.SelectDeviceAsync(Store.Devices.First());
        }
    }

    public void Dispose()
    {
        Store.OnChange -= HandleStoreChange;
    }

    private void HandleStoreChange()
    {
        InvokeAsync(StateHasChanged);
    }
}
