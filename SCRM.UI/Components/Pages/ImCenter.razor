@page "/im"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using SCRM.SHARED.Models.Dtos
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject NavigationManager NavManager
@inject NotificationService NoticeService
@inject DialogService DialogService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>SCRM Unified IM</PageTitle>

<style>
    .layout-container { height: calc(100vh - 60px); border: none; display: flex; overflow: hidden; }
    .device-sider { background: #fff; text-align: center; padding-top: 10px; overflow-y: auto; border-right: 1px solid #f0f0f0; width: 80px; flex-shrink: 0; }
    .contact-sider { background: #fdfdfd; border-right: 1px solid #e8e8e8; overflow-y: auto; width: 300px; display: flex; flex-direction: column; flex-shrink: 0; }
    .chat-content { background: #fff; display: flex; flex-direction: column; overflow: hidden; height: 100%; flex: 1; }
    
    .contact-item { cursor: pointer; padding: 12px 16px; border-bottom: 1px solid #f0f0f0; transition: 0.2s; display: flex; align-items: center; }
    .contact-item:hover { background: #f5f5f5; }
    .contact-item.active { background: #e6f7ff; }
    
    .chat-header { padding: 0 24px; border-bottom: 1px solid #f0f0f0; background: #fff; height: 64px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 24px; background: #f0f2f5; }
    .chat-input { padding: 16px 24px; background: #fff; border-top: 1px solid #f0f0f0; flex-shrink: 0; }
    
    .msg-row { margin-bottom: 20px; display: flex; width: 100%; }
    .msg-row.self { justify-content: flex-end; }
    .msg-bubble { max-width: 65%; padding: 10px 16px; border-radius: 4px; position: relative; word-wrap: break-word; font-size: 14px; line-height: 1.6; }
    .msg-row.other .msg-bubble { background: #fff; border: 1px solid #e8e8e8; border-top-left-radius: 0; }
    .msg-row.self .msg-bubble { background: #95ec69; border: 1px solid #7cd958; border-top-right-radius: 0; }
    
    .msg-pending { opacity: 0.6; }
    
    .tab-item { cursor: pointer; padding: 10px 15px; flex: 1; text-align: center; border-bottom: 2px solid transparent; transition: all 0.3s; color: #666; font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 5px; }
    .tab-item:hover { color: var(--rz-primary); background: #fafafa; }
    .tab-item.active { color: var(--rz-primary); border-bottom: 2px solid var(--rz-primary); background: var(--rz-base-200); }
</style>

<div class="layout-container">
    <!-- 1. Left Sider: Devices -->
    <div class="device-sider">
        <SCRM.UI.Components.Shared.DeviceList OnDeviceSelected="OnDeviceSelectedInternal" />
    </div>

    <!-- 2. Middle Sider: Contacts & Chats -->
    <div class="contact-sider">
        <!-- Tab Switcher -->
        <div style="display: flex; border-bottom: 1px solid #f0f0f0; background: #fff; flex-shrink: 0;">
            <div class="tab-item @(_activeTab == "chats" ? "active" : "")" @onclick="@(() => _activeTab = "chats")">
                <RadzenIcon Icon="chat" /> Chats
            </div>
            <div class="tab-item @(_activeTab == "contacts" ? "active" : "")" @onclick="@(() => _activeTab = "contacts")">
                <RadzenIcon Icon="contacts" /> Contacts
            </div>
        </div>

        @if (_activeTab == "chats")
        {
            <!-- Conversation List -->
             @if (Store.SelectedDevice == null)
             {
                 <div class="rz-p-4 rz-text-align-center text-muted">Select a Device</div>
             }
             else if (Store.Conversations.Count == 0)
             {
                 <div class="rz-p-4 rz-text-align-center text-muted">No chats</div>
             }
             else
             {
                 <div style="overflow-y: auto; flex: 1;">
                    @foreach (var conv in Store.Conversations)
                    {
                        var isActive = Store.SelectedConversation?.id == conv.id;
                        <div class="contact-item @(isActive ? "active" : "")" @onclick="@(() => SelectConversation(conv))">
                            <div style="position: relative;">
                                <RadzenImage Path="@conv.displayAvatar" Style="width: 40px; height: 40px; border-radius: 4px;" />
                                @if (conv.unreadCount > 0)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@(conv.unreadCount > 99 ? "99+" : conv.unreadCount.ToString())" Style="position: absolute; top: -5px; right: -5px;" />
                                }
                            </div>
                            <div style="margin-left: 10px; overflow: hidden; flex: 1;">
                                <div style="display: flex; justify-content: space-between;">
                                    <span style="font-weight: 500; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px;">
                                        @conv.displayName
                                    </span>
                                    <span style="font-size: 10px; color: #aaa;">
                                        @FormatDate(conv.lastMessageTime)
                                    </span>
                                </div>
                                <div style="font-size: 12px; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @(conv.conversationType == 2 ? "[Group] " : "") 
                                    @(string.IsNullOrEmpty(conv.lastMessageContent) ? "Chat Session" : conv.lastMessageContent)
                                </div>
                            </div>
                        </div>
                    }
                 </div>
             }
        }
        else
        {
            <!-- Contact List -->
            <div style="padding: 10px; border-bottom: 1px solid #d9d9d9; flex-shrink: 0;">
                <RadzenTextBox Placeholder="Search Contacts..." @bind-Value="_searchText" Change="@OnSearchContact" Style="width: 100%;" />
            </div>
            
            @if (Store.SelectedDevice == null)
            {
                <div class="rz-p-4 rz-text-align-center text-muted">Select a Device</div>
            }
            else if (Store.Contacts.Count == 0)
            {
                 <div class="rz-p-4 rz-text-align-center">
                    <RadzenButton Text="Sync Contacts" ButtonStyle="ButtonStyle.Secondary" Click="SyncContacts" Size="ButtonSize.Small" />
                 </div>
            }
            else
            {
                <div style="overflow-y: auto; flex: 1;">
                    @foreach (var contact in _filteredContacts)
                    {
                        <div class="contact-item @(Store.SelectedContact?.wxid == contact.wxid ? "active" : "")" 
                             @onclick="@(() => SelectContact(contact))">
                            <RadzenImage Path="@(string.IsNullOrEmpty(contact.avatar) ? "images/default-avatar.png" : contact.avatar)" Style="width: 40px; height: 40px; border-radius: 50%;" />
                            <div style="margin-left: 10px; overflow: hidden;">
                                <div style="font-weight: 500; font-size: 14px;">@(string.IsNullOrEmpty(contact.remarks) ? contact.nickname : contact.remarks)</div>
                                <div style="font-size: 12px; color: #888;">@contact.nickname</div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- 3. Right Content: Chat & Features -->
    <div class="chat-content">
        @if (Store.SelectedContact == null && Store.SelectedConversation == null)
        {
             @if (Store.SelectedDevice != null)
             {
                 <!-- Device Dashboard View when no contact selected -->
                 <div style="padding: 50px; text-align: center;">
                     <h3>@Store.SelectedDevice.weChatNick</h3>
                     <p>Status: @(Store.SelectedDevice.isOnline ? "Online" : "Offline")</p>
                     <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="1rem">
                        <RadzenButton Text="Capture Screen" Click="CaptureScreen" ButtonStyle="ButtonStyle.Primary" />
                        <RadzenButton Text="Moments" Click="GoToMoments" ButtonStyle="ButtonStyle.Secondary" />
                     </RadzenStack>
                     
                     @if (!string.IsNullOrEmpty(Store.LastScreenShotUrl))
                     {
                         <div style="margin-top: 20px; border: 1px solid #eee; padding: 10px; border-radius: 8px;">
                             <RadzenImage Path="@Store.LastScreenShotUrl" Width="300" />
                         </div>
                     }
                 </div>
             }
             else
             {
                 <div class="rz-p-12 rz-text-align-center">
                    <RadzenIcon Icon="chat_bubble_outline" Style="font-size: 4rem; color: #ccc;" />
                    <div class="rz-mt-4 text-muted">Select a Device and Contact/Chat to start</div>
                 </div>
             }
        }
        else
        {
            <!-- Chat Header -->
            <div class="chat-header">
                <span style="font-size: 16px; font-weight: 600;">
                    @{
                        var name = Store.SelectedContact?.remarks ?? Store.SelectedContact?.nickname 
                            ?? Store.SelectedConversation?.displayName ?? "Unknown";
                    }
                    @name
                </span>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Variant="Variant.Text" Click="DeleteFriend_Click" />
                </RadzenStack>
            </div>

            <!-- Chat Messages -->
            <div class="chat-messages" id="chat-box">
                @foreach (var msg in Store.CurrentMessages)
                {
                    <div class="msg-row @(msg.direction == 1 ? "self" : "other") @(msg.sendStatus == 1 ? "msg-pending" : "")">
                        @if(msg.direction != 1) {
                            <RadzenImage Path="@(ContextAvatar())" Style="width:36px; height:36px; border-radius: 4px; margin-right: 10px;" />
                        }
                        
                        <div class="msg-bubble">
                            @msg.content
                            @if (msg.sendStatus == 1)
                            {
                                <RadzenIcon Icon="sync" Style="font-size: 12px; margin-left: 8px; animation: rz-spin 1s infinite linear;" />
                            }
                        </div>
                        
                        @if(msg.direction == 1) {
                             <RadzenImage Path="@Store.SelectedDevice.weChatAvatar" Style="width:36px; height:36px; border-radius: 4px; margin-left: 10px; background-color: #87d068;" />
                        }
                    </div>
                }
                <div id="scroll-anchor"></div>
            </div>

            <!-- Chat Input -->
            <div class="chat-input">
                <RadzenTextArea @bind-Value="_msgContent" Rows="4" Style="width: 100%; border: none; box-shadow: none;" Placeholder="Type a message..." 
                          @onkeydown="HandleKeyPress" />
                <div style="text-align: right; margin-top: 10px;">
                    <RadzenButton Text="Send" Click="Send" IsBusy="@_sending" ButtonStyle="ButtonStyle.Primary" />
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _msgContent = "";
    private string _searchText = "";
    private bool _sending = false;
    private string _activeTab = "chats"; // Default to Chats
    
    // Helper to get avatar for current chat context
    private string ContextAvatar()
    {
        if (Store.SelectedContact != null) return Store.SelectedContact.avatar ?? "images/default-avatar.png";
        if (Store.SelectedConversation != null) return Store.SelectedConversation.displayAvatar ?? "images/default-avatar.png";
        return "images/default-avatar.png";
    }

    private List<Contact> _filteredContacts => string.IsNullOrWhiteSpace(_searchText) 
        ? Store.Contacts 
        : Store.Contacts.Where(c => (c.nickname?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) 
                                 || (c.remarks?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleStoreChange;
        Store.OnNotification += HandleStoreNotification;
        
        await Store.InitializeAsync();
        
        // Auto-select first device if available
        if (Store.SelectedDevice == null && Store.Devices.Count > 0)
        {
            await SelectDevice(Store.Devices.First());
        }
    }

    public void Dispose()
    {
        Store.OnChange -= HandleStoreChange;
        Store.OnNotification -= HandleStoreNotification;
    }
    
    private void HandleStoreChange()
    {
        InvokeAsync(async () => {
            StateHasChanged();
            await ScrollToBottom();
        });
    }
    
    private void HandleStoreNotification(string msg, bool success)
    {
        InvokeAsync(() => HandleNotification(msg, success));
    }

    private async Task OnDeviceSelectedInternal(SrClient device)
    {
        await SelectDevice(device);
    }

    private async Task SelectDevice(SrClient device)
    {
        await Store.SelectDeviceAsync(device);
    }

    private async Task SelectContact(Contact contact)
    {
        await Store.SelectContactAsync(contact);
    }
    
    private async Task SelectConversation(Conversation conv)
    {
        await Store.SelectConversationAsync(conv);
    }

    private async Task RefreshDevices()
    {
        await Store.LoadDevicesAsync();
        NoticeService.Notify(NotificationSeverity.Success, "Refreshed");
    }

    private async Task SyncContacts()
    {
        if (Store.SelectedDevice == null) return;
        await Store.SyncContactsAsync();
        NoticeService.Notify(NotificationSeverity.Info, "Sync Command Sent");
    }

    private void OnSearchContact()
    {
        StateHasChanged();
    }
    
    private void GoToMoments()
    {
        NavManager.NavigateTo("/moments");
    }

    private async Task CaptureScreen()
    {
        if (Store.SelectedDevice == null) return;
        await Store.RequestScreenShotAsync(Store.SelectedDevice.uuid);
        NoticeService.Notify(NotificationSeverity.Info, "Screenshot Requested");
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_msgContent) || Store.SelectedDevice == null || (Store.SelectedContact == null && Store.SelectedConversation == null)) return;
        
        _sending = true;
        var result = await Store.SendMessageAsync(_msgContent);
        if (result)
        {
            _msgContent = "";
        }
        else
        {
            NoticeService.Notify(NotificationSeverity.Error, "Failed to send");
        }
        _sending = false;
    }
    
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.CtrlKey && (e.Key == "Enter" || e.Key == "NumpadEnter"))
        {
            await Send();
        }
    }

    private async Task DeleteFriend_Click()
    {
         if (Store.SelectedDevice == null || Store.SelectedContact == null) return;
         
         var result = await DialogService.Confirm("Are you sure delete this friend?", "Delete Friend", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
         if (result == true)
         {
             await Store.DeleteFriendAsync(Store.SelectedContact.wxid);
             NoticeService.Notify(NotificationSeverity.Success, "Delete Command Sent");
         }
    }

    private void HandleNotification(string msg, bool success)
    {
          NoticeService.Notify(success ? NotificationSeverity.Success : NotificationSeverity.Error, success ? "Success" : "Error", msg);
    }

    private async Task ScrollToBottom()
    {
        try {
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('chat-box'); if(el) el.scrollTop = el.scrollHeight;");
        } catch {}
    }

    private string FormatDate(DateTime dt)
    {
        if (dt.Date == DateTime.Today)
            return dt.ToString("HH:mm");
        if (dt.Date == DateTime.Today.AddDays(-1))
            return "Yesterday";
        if (dt.Year == DateTime.Now.Year)
            return dt.ToString("MM-dd");
        return dt.ToString("yyyy-MM-dd");
    }
}
