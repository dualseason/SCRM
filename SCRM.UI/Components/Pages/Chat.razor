@page "/chat"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using AntDesign
@inject CrmStore Store
@inject NavigationManager NavManager
@inject INotificationService NoticeService
@implements IDisposable

<PageTitle>Chat</PageTitle>

@if (Store.SelectedContact == null)
{
    <Result Status="@AntDesign.ResultStatus.Error" Title="No Chat Selected" SubTitle="Please select a contact from the list.">
        <Extra>
            <Button Type="@AntDesign.ButtonType.Primary" OnClick="@(()=>NavManager.NavigateTo("/contacts"))">Go to Contacts</Button>
        </Extra>
    </Result>
}
else
{
    <Card Title="@($"Chat with {Store.SelectedContact.Nickname} ({Store.SelectedContact.Wxid})")" BodyStyle="padding:0;">
        <div style="height: 60vh; overflow-y: auto; padding: 20px; background: #f0f2f5;">
            @foreach (var msg in Store.CurrentMessages)
            {
                <div style="display: flex; justify-content: @(msg.Direction == 1 ? "flex-end" : "flex-start"); margin-bottom: 10px;">
                    <div style="max-width: 70%; padding: 10px; border-radius: 8px; background: @(msg.Direction == 1 ? "#95ec69" : "#ffffff"); border: 1px solid #e8e8e8;">
                        <div>@msg.Content</div>
                        <div style="font-size: 10px; color: #999; text-align: right; margin-top: 4px;">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                </div>
            }
        </div>
        <div style="padding: 20px; border-top: 1px solid #e8e8e8;">
            <TextArea @bind-Value="_msgContent" AutoSize="true" MinRows="3" Placeholder="Type a message..." />
            <div style="margin-top: 10px; text-align: right;">
                 <Button Type="@AntDesign.ButtonType.Primary" OnClick="Send" Loading="@_sending">Send</Button>
            </div>
        </div>
    </Card>
}

@code {
    string _msgContent;
    bool _sending = false;

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += StateHasChanged;
        Store.OnNotification += HandleNotification;
        await Store.InitializeAsync();
    }

    public void Dispose()
    {
        Store.OnChange -= StateHasChanged;
        Store.OnNotification -= HandleNotification;
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_msgContent)) return;
        
        _sending = true;
        await Store.SendMessageAsync(_msgContent);
        _msgContent = "";
        _sending = false;
    }
    
    private void HandleNotification(string msg, bool success)
    {
         if(!success) {
            NoticeService.Open(new NotificationConfig()
            {
                Message = "Error",
                Description = msg,
                NotificationType = AntDesign.NotificationType.Error
            });
         }
    }
}
