@page "/chat"
@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject NavigationManager NavManager
@inject NotificationService NoticeService
@implements IDisposable

<PageTitle>联系人对话</PageTitle>

@if (Store.SelectedContact == null)
{
    <RadzenCard Class="rz-my-12 rz-mx-auto" Style="max-width: 400px; text-align: center;">
        <RadzenIcon Icon="forum" Style="font-size: 3rem; color: var(--rz-danger);" />
        <RadzenText TextStyle="TextStyle.H5" Class="rz-mt-4">未选择联系人</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Class="rz-mb-4">请先在联系人列表中选择一个好友进行对话。</RadzenText>
        <RadzenButton Text="前往联系人列表" ButtonStyle="ButtonStyle.Primary" Click="@(()=>NavManager.NavigateTo("/contacts"))" />
    </RadzenCard>
}
else
{
    <RadzenStack Style="height: calc(100vh - 100px); max-width: 800px; margin: 0 auto;">
        <RadzenCard Style="flex: 1; display: flex; flex-direction: column; overflow: hidden; padding: 0;">
             <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="padding: 1rem; border-bottom: 1px solid var(--rz-border-color);">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(()=>NavManager.NavigateTo("/contacts"))" Size="ButtonSize.Small" />
                <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-mb-0">
                    与 @Store.SelectedContact.nickname (@Store.SelectedContact.wxid) 对话中
                </RadzenText>
             </RadzenStack>

            <div style="flex: 1; overflow-y: auto; padding: 1rem; background-color: var(--rz-base-background-color);">
                @foreach (var msg in Store.CurrentMessages)
                {
                    <div style="display: flex; justify-content: @(msg.direction == 1 ? "flex-end" : "flex-start"); margin-bottom: 10px;">
                        <div style="max-width: 80%; padding: 10px 15px; border-radius: 12px;
                                    background: @(msg.direction == 1 ? "var(--rz-primary)" : "var(--rz-base-200)");
                                    color: @(msg.direction == 1 ? "var(--rz-white)" : "var(--rz-text-title-color)");
                                    border: 1px solid @(msg.direction == 1 ? "var(--rz-primary)" : "var(--rz-border-color));");">
                            <div style="word-break: break-all;">@msg.content</div>
                            <div style="font-size: 0.75rem; opacity: 0.7; text-align: right; margin-top: 4px;">
                                @msg.createdAt.ToLocalTime().ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div style="padding: 1rem; border-top: 1px solid var(--rz-border-color);">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenTextArea @bind-Value="_msgContent" Placeholder="输入消息..." Style="flex: 1;" Rows="2" @onkeydown="@Enter" />
                    <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Click="Send" IsBusy="@_sending" Style="height: auto;" />
                </RadzenStack>
            </div>
        </RadzenCard>
    </RadzenStack>
}

@code {
    string _msgContent;
    bool _sending = false;

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleChange;
        Store.OnNotification += HandleNotification;
        await Store.InitializeAsync();
    }

    private async void HandleChange()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.OnChange -= HandleChange;
        Store.OnNotification -= HandleNotification;
    }

    private void Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
             // Optional: Handle Enter to send
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_msgContent)) return;
        
        _sending = true;
        await Store.SendMessageAsync(_msgContent);
        _msgContent = "";
        _sending = false;
    }
    
    private void HandleNotification(string msg, bool success)
    {
         if(!success) {
            _ = InvokeAsync(() => {
                NoticeService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = msg });
            });
         }
    }
}
