@page "/settings"
@using SCRM.API.Models.Entities
@using SCRM.UI.Services
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@inject ISystemConfigService ConfigService
@inject NotificationService NotificationService
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.H4">全局系统设置 (System Settings)</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1">所有设置修改后将自动推送到在线客户端。请谨慎修改。</RadzenText>
    
    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="服务端设置 (Server Settings)">
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                        <RadzenRow AlignItems="AlignItems.Center">
                             <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="TCP 服务器主机 (host)" Component="host" />
                                <RadzenText TextStyle="TextStyle.Caption">客户端连接 Netty 的 IP/域名</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenTextBox @bind-Value=@configModel.host Name="host" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="TCP 服务器端口 (port)" Component="port" />
                                 <RadzenText TextStyle="TextStyle.Caption">客户端连接 Netty 的端口</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenNumeric @bind-Value=@configModel.port Name="port" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="文件上传 URL (fileUpUrl)" Component="fileUpUrl" />
                                <RadzenText TextStyle="TextStyle.Caption">用于上传截图/日志 (完整 HTTP URL)</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenTextBox @bind-Value=@configModel.fileUpUrl Name="fileUpUrl" Style="width: 100%" Placeholder="http://..." />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="API 基础 URL (httpApiBaseUrl)" Component="httpApiBaseUrl" />
                                <RadzenText TextStyle="TextStyle.Caption">REST API 接口地址</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenTextBox @bind-Value=@configModel.httpApiBaseUrl Name="httpApiBaseUrl" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="自动更新 URL (autoUpdateUrl)" Component="autoUpdateUrl" />
                                <RadzenText TextStyle="TextStyle.Caption">APK 更新检查地址</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenTextBox @bind-Value=@configModel.autoUpdateUrl Name="autoUpdateUrl" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="Token 有效期 (分钟)" Component="tokenExpiryMinutes" />
                                <RadzenText TextStyle="TextStyle.Caption">默认 180 天 (259200 分钟)</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenNumeric @bind-Value=@configModel.tokenExpiryMinutes Name="tokenExpiryMinutes" Style="width: 100%" Min="1" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </RadzenTabsItem>

            <RadzenTabsItem Text="安卓客户端设置 (Client Settings)">
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="配置文件路径 (clientConfigPath)" Component="clientConfigPath" />
                                 <RadzenText TextStyle="TextStyle.Caption">本地存储路径 (建议隐藏路径，如 /sdcard/Android/media/.cache/sys_config.dat)</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenTextBox @bind-Value=@configModel.clientConfigPath Name="clientConfigPath" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="日志级别 (logLevel)" Component="logLevel" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenDropDown @bind-Value=@configModel.logLevel Data=@(new [] {"DEBUG", "INFO", "WARN", "ERROR"}) Name="logLevel" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="自动登录 (autoLogin)" Component="autoLogin" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.autoLogin Name="autoLogin" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="自动下载图片 (autoPic)" Component="autoPic" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.autoPic Name="autoPic" />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="静默功能 (silentFunc)" Component="silentFunc" />
                                <RadzenText TextStyle="TextStyle.Caption">隐藏通知栏图标</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                 <RadzenSwitch @bind-Value=@configModel.silentFunc Name="silentFunc" />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="强制运行 (forceRun)" Component="forceRun" />
                                 <RadzenText TextStyle="TextStyle.Caption">尝试后台保活</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.forceRun Name="forceRun" />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="保持唤醒间隔 (keepWake)" Component="keepWake" />
                                 <RadzenText TextStyle="TextStyle.Caption">分钟</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenNumeric @bind-Value=@configModel.keepWake Name="keepWake" Style="width: 100%" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </RadzenTabsItem>

            <RadzenTabsItem Text="客户端行为增强 (Behavior)">
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="静默发消息 (fastSend)" Component="fastSend" />
                                <RadzenText TextStyle="TextStyle.Caption">无UI跳转发送消息</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.fastSend Name="fastSend" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="静默加人 (silentAccept)" Component="silentAccept" />
                                <RadzenText TextStyle="TextStyle.Caption">自动通过好友请求 (无UI)</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.silentAccept Name="silentAccept" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="企微加好友 (addInWw)" Component="addInWw" />
                                <RadzenText TextStyle="TextStyle.Caption">通过请求时同步添加到企微 (需重启)</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.addInWw Name="addInWw" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="减少亮屏 (lightscn)" Component="lightscn" />
                                <RadzenText TextStyle="TextStyle.Caption">断网重连时不亮屏</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.lightscn Name="lightscn" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="免打扰 (disturb)" Component="disturb" />
                                <RadzenText TextStyle="TextStyle.Caption">不主动亮屏</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.disturb Name="disturb" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="详细日志 (moreLog)" Component="moreLog" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.moreLog Name="moreLog" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </RadzenTabsItem>

            <RadzenTabsItem Text="微信权限控制 (Permissions)">
                <RadzenCard>
                    <RadzenStack Gap="1.5rem">
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="越权提示 (wx_show_toast)" Component="wx_show_toast" />
                                <RadzenText TextStyle="TextStyle.Caption">操作禁止功能时弹窗提示</RadzenText>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_show_toast Name="wx_show_toast" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="显示微信号 (wx_show_alias)" Component="wx_show_alias" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_show_alias Name="wx_show_alias" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许删除好友 (wx_can_delete)" Component="wx_can_delete" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_delete Name="wx_can_delete" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许拉黑 (wx_can_block)" Component="wx_can_block" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_block Name="wx_can_block" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许退群 (wx_can_exitGroup)" Component="wx_can_exitGroup" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_exitGroup Name="wx_can_exitGroup" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许退出登录 (wx_can_logout)" Component="wx_can_logout" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_logout Name="wx_can_logout" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许切换账号 (wx_can_changeAcnt)" Component="wx_can_changeAcnt" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_changeAcnt Name="wx_can_changeAcnt" />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许查看账号安全 (wx_can_acntInfo)" Component="wx_can_acntInfo" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_acntInfo Name="wx_can_acntInfo" />
                            </RadzenColumn>
                        </RadzenRow>
                         <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenLabel Text="允许发送名片 (wx_can_sendcard)" Component="wx_can_sendcard" />
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="8">
                                <RadzenSwitch @bind-Value=@configModel.wx_can_sendcard Name="wx_can_sendcard" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" Class="rz-mt-2">
        <RadzenButton Icon="save" Text="保存并推送所有配置" Click=@SaveAllConfigs ButtonStyle="ButtonStyle.Primary" IsBusy=@isSaving />
    </RadzenStack>
</RadzenStack>

@code {
    private SCRM.SHARED.Models.SystemConfigModel configModel = new();
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigs();
    }

    private async Task LoadConfigs()
    {
        configModel = await ConfigService.GetConfigModelAsync();
    }

    private async Task SaveAllConfigs()
    {
        isSaving = true;
        try
        {
            await ConfigService.UpdateModelAsync(configModel);
            NotificationService.Notify(NotificationSeverity.Success, "保存成功", "所有配置已更新并推送");
            // Optional: Reload to ensure local model matches server state (though typically same)
            // await LoadConfigs(); 
        }
        catch (Exception ex)
        {
             NotificationService.Notify(NotificationSeverity.Error, "保存失败", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }
}
