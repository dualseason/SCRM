@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using Radzen
@using Radzen.Blazor
@using System.Linq
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Microsoft.Extensions.Configuration
@using System.Net.Http
@inject CrmStore Store
@inject NotificationService NoticeService
@inject IJSRuntime JS
@inject DialogService DialogService
@inject NavigationManager NavManager
@inject IConfiguration Config
@inject ISystemConfigService SystemConfigService
@inject HttpClient UploadHttpClient
@implements IDisposable

<RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="height: 100%; min-height: 0; overflow: hidden; background: var(--rz-base-100);">
    @* 场景一：当前在通讯录列表页 *@
    @if (ActiveTab == "contacts")
    {
        if (Store.SelectedContact == null)
        {
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%;">
                <RadzenText Text="请选择联系人" TextStyle="TextStyle.Body1" Style="color:var(--rz-text-secondary-color);" />
            </RadzenStack>
        }
        else
        {
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%; background:var(--rz-base-0); padding:20px;">
                <div style="width: 400px; text-align:center;">
                    <RadzenImage Path="@(string.IsNullOrEmpty(Store.SelectedContact.avatar) ? "images/default-avatar.png" : Store.SelectedContact.avatar)" Style="width:120px; height:120px; border-radius:8px; margin-bottom:20px;" />
                    <RadzenText Text="@(string.IsNullOrEmpty(Store.SelectedContact.remarks) ? Store.SelectedContact.nickname : Store.SelectedContact.remarks)" TextStyle="TextStyle.H5" Style="font-weight:600; color:var(--rz-text-title-color);" />
                    
                    <div style="margin-top:30px; text-align:left; background:var(--rz-base-200); padding:20px; border-radius:8px;">
                        <div style="margin-bottom: 10px;">
                            <span style="color:var(--rz-text-secondary-color); display:inline-block; width:70px;">微信号</span>
                            <span style="color:var(--rz-text-title-color);">
                                @(string.IsNullOrWhiteSpace(Store.SelectedContact.friendNo) ? "-" : Store.SelectedContact.friendNo)
                            </span>
                        </div>
                        <div>
                            <span style="color:var(--rz-text-secondary-color); display:inline-block; width:70px;">微信ID</span>
                            <span style="color:var(--rz-text-title-color);">@Store.SelectedContact.wxid</span>
                        </div>
                    </div>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" JustifyContent="JustifyContent.Center" Style="margin-top:40px;">
                        <RadzenButton Text="发消息" Icon="chat" Click="StartChatWithContact" ButtonStyle="ButtonStyle.Success" Style="width:120px; height:40px; font-size:15px;" />
                        <RadzenButton Text="删除好友" Icon="delete" Click="DeleteSelectedContact" ButtonStyle="ButtonStyle.Danger" Style="width:120px; height:40px; font-size:15px;" />
                        <RadzenButton Text="添加好友" Icon="person_add" Click="GoAddFriend" ButtonStyle="ButtonStyle.Light" Style="width:120px; height:40px; font-size:15px;" />
                    </RadzenStack>
                </div>
            </RadzenStack>
        }
    }
    @* 场景二：当前在会话列表页/群聊列表页 *@
    else if (ActiveTab == "chats" || ActiveTab == "groups")
    {
        if (Store.SelectedConversation == null)
        {
            <!-- Empty State -->
            <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%;">
                <RadzenIcon Icon="chat_bubble_outline" Style="font-size: 4rem; color: var(--rz-text-disabled-color);" />
                <RadzenText Text="请选择会话开始聊天" TextStyle="TextStyle.Body1" Style="color: var(--rz-text-disabled-color); margin-top: 10px;" />
            </RadzenStack>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="height: 100%; min-height: 0; overflow: hidden; width: 100%;">
                <!-- Chat Header -->
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" 
                             Style="height: 50px; min-height: 50px; padding: 0 1rem; border-bottom: 1px solid var(--rz-border-color); background: var(--rz-base-0);">
                    <RadzenText Text="@(Store.SelectedConversation?.displayName ?? "Unknown")" 
                                TextStyle="TextStyle.Subtitle1" Style="margin: 0; font-weight: 600;" />
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.35rem" AlignItems="AlignItems.Center">
                        @if (IsCurrentConversationChatRoom())
                        {
                            <RadzenButton Text="群接龙" Icon="playlist_add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenJielongDialog" />
                        }
                        else
                        {
                            <RadzenButton Text="加好友" Icon="person_add" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="GoAddFriend" />
                            <RadzenButton Text="权限" Icon="lock_person" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenFriendPermissionDialog" />
                            <RadzenButton Text="删好友" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="DeleteSelectedConversationFriend" />
                        }
                        <RadzenButton Icon="more_horiz" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Medium" />
                    </RadzenStack>
                </RadzenStack>

                <!-- Chat Messages (Scrollable) -->
                <div id="im-chat-box" class="rz-p-4" style="flex: 1 1 auto; min-height: 0; overflow-y: auto;">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                        @foreach (var msg in Store.CurrentMessages.ToList())
                       {
                           bool isMine = IsMyMessage(msg);
                           var display = BuildMessageDisplay(msg, isMine);

                           <RadzenStack Orientation="Orientation.Horizontal"
                                        JustifyContent="@(isMine ? JustifyContent.End : JustifyContent.Start)"
                                        Style="width: 100%;">
                               <RadzenStack Orientation="Orientation.Vertical"
                                            AlignItems="@(isMine ? AlignItems.End : AlignItems.Start)"
                                            Style="max-width: 70%;">
                                   <RadzenImage Path="@display.Avatar"
                                                Style="width:36px; height:36px; border-radius: 4px; margin-bottom: 6px;" />

                                   @if (display.ShowSenderName)
                                   {
                                       <RadzenText Text="@display.SenderDisplayName"
                                                   TextStyle="TextStyle.Caption"
                                                   Style="margin: 0 0 3px 0; color: var(--rz-text-secondary-color); word-break: break-all;" />
                                   }

                                   <RadzenCard Style="@($"max-width: 100%; padding: 8px 12px; border-radius: 4px; position: relative; font-size: 14px; line-height: 1.5; background-color: {(isMine ? "var(--rz-primary-light)" : "var(--rz-base-0)")}; border: {(isMine ? "none" : "1px solid var(--rz-border-color)")}; box-shadow: none;")">
                                       @if (display.Kind == ChatMessageKind.Image && !string.IsNullOrWhiteSpace(display.MediaUrl))
                                       {
                                           <RadzenStack Gap="0.35rem">
                                               @if (HasChatMediaAccessUrl(display.MediaUrl))
                                               {
                                                   <a href="@GetChatMediaAccessUrl(display.MediaUrl)" target="_blank" rel="noopener" title="打开短期图片链接">
                                                       <RadzenImage Path="@GetChatMediaAccessUrl(display.MediaUrl)" Style="max-width: 260px; max-height: 220px; object-fit: contain; border-radius: 4px;" />
                                                   </a>
                                                   <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-secondary">@FormatChatMediaTokenExpires(display.MediaUrl)</RadzenText>
                                               }
                                               else
                                               {
                                                   <div style="font-size: 12px; color: var(--rz-text-secondary-color);">图片已通过短期链接保护</div>
                                               }
                                               <RadzenButton Text="@(GetChatMediaAccessButtonText(display.MediaUrl, "查看图片"))"
                                                             Icon="image"
                                                             ButtonStyle="ButtonStyle.Light"
                                                             Variant="Variant.Outlined"
                                                             Size="ButtonSize.ExtraSmall"
                                                             Click="@(() => PrepareChatMediaAccessAsync(display.MediaUrl, msg.accountId, Store.SelectedDevice?.uuid))"
                                                             Disabled="@IsPreparingChatMediaAccess(display.MediaUrl)" />
                                           </RadzenStack>
                                       }
                                       else if (display.Kind == ChatMessageKind.Video && !string.IsNullOrWhiteSpace(display.MediaUrl))
                                       {
                                           <RadzenStack Gap="0.35rem">
                                               @if (HasChatMediaAccessUrl(display.MediaUrl))
                                               {
                                                   <video src="@GetChatMediaAccessUrl(display.MediaUrl)" controls style="max-width: 320px; max-height: 240px; border-radius: 4px;"></video>
                                                   <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-secondary">@FormatChatMediaTokenExpires(display.MediaUrl)</RadzenText>
                                               }
                                               else
                                               {
                                                   <div style="font-size: 12px; color: var(--rz-text-secondary-color);">视频已通过短期链接保护</div>
                                               }
                                               <RadzenButton Text="@(GetChatMediaAccessButtonText(display.MediaUrl, "播放视频"))"
                                                             Icon="play_circle"
                                                             ButtonStyle="ButtonStyle.Light"
                                                             Variant="Variant.Outlined"
                                                             Size="ButtonSize.ExtraSmall"
                                                             Click="@(() => PrepareChatMediaAccessAsync(display.MediaUrl, msg.accountId, Store.SelectedDevice?.uuid))"
                                                             Disabled="@IsPreparingChatMediaAccess(display.MediaUrl)" />
                                           </RadzenStack>
                                       }
                                       else if (display.Kind == ChatMessageKind.Emoji && !string.IsNullOrWhiteSpace(display.MediaUrl))
                                       {
                                           <RadzenStack Gap="0.35rem">
                                               @if (HasChatMediaAccessUrl(display.MediaUrl))
                                               {
                                                   <a href="@GetChatMediaAccessUrl(display.MediaUrl)" target="_blank" rel="noopener" title="打开短期表情链接">
                                                       <RadzenImage Path="@GetChatMediaAccessUrl(display.MediaUrl)" Style="max-width: 140px; max-height: 140px; object-fit: contain; border-radius: 4px;" />
                                                   </a>
                                                   <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-secondary">@FormatChatMediaTokenExpires(display.MediaUrl)</RadzenText>
                                               }
                                               else
                                               {
                                                   <div style="font-size: 12px; color: var(--rz-text-secondary-color);">表情已通过短期链接保护</div>
                                               }
                                               <RadzenButton Text="@(GetChatMediaAccessButtonText(display.MediaUrl, "查看表情"))"
                                                             Icon="sentiment_satisfied"
                                                             ButtonStyle="ButtonStyle.Light"
                                                             Variant="Variant.Outlined"
                                                             Size="ButtonSize.ExtraSmall"
                                                             Click="@(() => PrepareChatMediaAccessAsync(display.MediaUrl, msg.accountId, Store.SelectedDevice?.uuid))"
                                                             Disabled="@IsPreparingChatMediaAccess(display.MediaUrl)" />
                                           </RadzenStack>
                                       }
                                        else if (display.Kind == ChatMessageKind.Voice)
                                        {
                                            <RadzenStack Orientation="Orientation.Vertical" Gap="0.35rem">
                                               @if (!string.IsNullOrWhiteSpace(display.MediaUrl))
                                               {
                                                   @if (HasChatMediaAccessUrl(display.MediaUrl))
                                                   {
                                                       <audio src="@GetChatMediaAccessUrl(display.MediaUrl)" controls style="max-width: 260px;"></audio>
                                                       <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-secondary">@FormatChatMediaTokenExpires(display.MediaUrl)</RadzenText>
                                                   }
                                                   else
                                                   {
                                                       <div style="font-size: 12px; color: var(--rz-text-secondary-color);">语音已通过短期链接保护</div>
                                                   }
                                                   <RadzenButton Text="@(GetChatMediaAccessButtonText(display.MediaUrl, "播放语音"))"
                                                                 Icon="volume_up"
                                                                 ButtonStyle="ButtonStyle.Light"
                                                                 Variant="Variant.Outlined"
                                                                 Size="ButtonSize.ExtraSmall"
                                                                 Click="@(() => PrepareChatMediaAccessAsync(display.MediaUrl, msg.accountId, Store.SelectedDevice?.uuid))"
                                                                 Disabled="@IsPreparingChatMediaAccess(display.MediaUrl)" />
                                               }
                                               else
                                               {
                                                   <div style="font-size: 12px; color: var(--rz-text-secondary-color);">语音文件暂未回填</div>
                                               }
                                               <RadzenButton Text="转文字"
                                                             Icon="subtitles"
                                                             ButtonStyle="ButtonStyle.Light"
                                                             Variant="Variant.Outlined"
                                                             Size="ButtonSize.ExtraSmall"
                                                             Click="@(() => VoiceTransTextMessage(msg))"
                                                             Disabled="@(_sending || msg.msgSvrId.GetValueOrDefault() == 0)" />
                                               @if (display.VoiceTransText != null)
                                               {
                                                   <div style="@GetVoiceTransTextBlockStyle(display.VoiceTransText)">
                                                       <div style="font-weight: 600; margin-bottom: 2px;">@GetVoiceTransTextTitle(display.VoiceTransText)</div>
                                                       <div style="white-space: pre-wrap; word-break: break-word;">@GetVoiceTransTextBody(display.VoiceTransText)</div>
                                                       @if (!string.IsNullOrWhiteSpace(display.VoiceTransText.voiceUrl))
                                                       {
                                                           <div style="margin-top: 2px; font-size: 11px; opacity: 0.8;">语音源：已通过短期链接保护</div>
                                                       }
                                                   </div>
                                                }
                                            </RadzenStack>
                                        }
                                         else if (ShouldRenderAdvancedCard(display))
                                         {
                                             var advanced = display.Advanced!;
                                             <ImCenterAdvancedMessageCard KindLabel="@GetAdvancedKindLabel(advanced.SemanticKind)"
                                                                          Title="@GetAdvancedTitle(advanced)"
                                                                          Description="@GetAdvancedDescription(advanced)"
                                                                          CoverUrl="@GetAdvancedCoverUrl(advanced)"
                                                                           PrimaryUrl="@GetAdvancedPrimaryUrl(advanced)"
                                                                           Meta="@GetAdvancedMeta(advanced)"
                                                                           ShowLocation="@(advanced.Location != null)"
                                                                           LocationLabel="@FirstNonEmpty(advanced.Location?.Label, advanced.Location?.Title, advanced.Description)"
                                                                           ShowLocationCoordinates="@(advanced.Location?.Longitude.HasValue == true || advanced.Location?.Latitude.HasValue == true)"
                                                                           LocationLongitude="@FormatCoordinate(advanced.Location?.Longitude)"
                                                                           LocationLatitude="@FormatCoordinate(advanced.Location?.Latitude)"
                                                                           ShowQuote="@(advanced.Quote != null)"
                                                                           QuoteSource='@FirstNonEmpty(advanced.Quote?.DisplayName, advanced.Quote?.QuoteUser, advanced.SourceName, "原消息")'
                                                                           QuoteBody='@FirstNonEmpty(advanced.Quote?.Title, advanced.Quote?.Content, advanced.Description, "（引用内容为空）")' />
                                         }
                                        else if (display.Kind == ChatMessageKind.File && !string.IsNullOrWhiteSpace(display.MediaUrl))
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                               <RadzenIcon Icon="description" Style="font-size: 20px;" />
                                               @if (HasChatMediaAccessUrl(display.MediaUrl))
                                               {
                                                   <a href="@GetChatMediaAccessUrl(display.MediaUrl)" target="_blank" rel="noopener">@display.FileName</a>
                                                   <RadzenText TextStyle="TextStyle.Caption" Class="rz-color-secondary">@FormatChatMediaTokenExpires(display.MediaUrl)</RadzenText>
                                               }
                                               else
                                               {
                                                   <span>@display.FileName</span>
                                               }
                                               <RadzenButton Text="@(GetChatMediaAccessButtonText(display.MediaUrl, "打开文件"))"
                                                             Icon="open_in_new"
                                                             ButtonStyle="ButtonStyle.Light"
                                                             Variant="Variant.Outlined"
                                                             Size="ButtonSize.ExtraSmall"
                                                             Click="@(() => PrepareChatMediaAccessAsync(display.MediaUrl, msg.accountId, Store.SelectedDevice?.uuid))"
                                                             Disabled="@IsPreparingChatMediaAccess(display.MediaUrl)" />
                                           </RadzenStack>
                                       }
                                       else
                                       {
                                           <span style="white-space: pre-wrap; word-break: break-word;">@display.Body</span>
                                       }
                                       @if (msg.sendStatus == 1)
                                       {
                                           <RadzenIcon Icon="sync" Style="font-size: 12px; margin-left: 8px; animation: rz-spin 1s infinite linear;" />
                                       }
                                   </RadzenCard>
                                    @if (HasMediaMetadata(display))
                                    {
                                        <div style="margin-top: 4px; max-width: 100%; font-size: 11px; color: var(--rz-text-secondary-color);">
                                            <div style="border: 1px dashed var(--rz-border-color); border-radius: 4px; padding: 6px 8px; background: var(--rz-base-50);">
                                                @if (display.MediaAttachments.Any())
                                                {
                                                    <div style="font-weight: 600; margin-bottom: 3px;">媒体附件 @display.MediaAttachments.Count 条</div>
                                                    @foreach (var media in display.MediaAttachments.Take(5))
                                                    {
                                                        <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap; word-break: break-all; margin-top: 2px;">
                                                            <span>@FormatMediaType(media.mediaType)</span>
                                                            @if (media.fileSize > 0)
                                                            {
                                                                <span>@FormatFileSize(media.fileSize)</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(media.fileExtension))
                                                            {
                                                                <span>.@media.fileExtension.TrimStart('.')</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(media.mediaHash))
                                                            {
                                                                <span title="@media.mediaHash">FileId=@TruncateMiddle(media.mediaHash, 24)</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(media.mediaUrl))
                                                            {
                                                                @if (HasChatMediaAccessUrl(media.mediaUrl))
                                                                {
                                                                    <a href="@GetChatMediaAccessUrl(media.mediaUrl)" target="_blank" rel="noopener">打开短期链接</a>
                                                                    <span>@FormatChatMediaTokenExpires(media.mediaUrl)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>媒体链接已隐藏</span>
                                                                }
                                                                <RadzenButton Text="@(GetChatMediaAccessButtonText(media.mediaUrl, "生成短期链接"))"
                                                                              Icon="link"
                                                                              ButtonStyle="ButtonStyle.Light"
                                                                              Variant="Variant.Text"
                                                                              Size="ButtonSize.ExtraSmall"
                                                                              Click="@(() => PrepareChatMediaAccessAsync(media.mediaUrl, msg.accountId, Store.SelectedDevice?.uuid))"
                                                                              Disabled="@IsPreparingChatMediaAccess(media.mediaUrl)" />
                                                            }
                                                        </div>
                                                    }
                                                    @if (display.MediaAttachments.Count > 5)
                                                    {
                                                        <div style="margin-top: 2px;">其余 @(display.MediaAttachments.Count - 5) 条已折叠。</div>
                                                    }
                                                }
                                                @if (display.MessageExtensions.Any())
                                                {
                                                    <div style="font-weight: 600; margin-top: @(display.MediaAttachments.Any() ? "6px" : "0"); margin-bottom: 3px;">补偿上下文 @display.MessageExtensions.Count 条</div>
                                                    @foreach (var extension in display.MessageExtensions.Take(4))
                                                    {
                                                        <div style="margin-top: 3px; word-break: break-all;">
                                                            <div>
                                                                <span style="font-weight: 600;">@extension.extensionKey</span>
                                                                <span>：@FormatMessageExtensionSummary(extension)</span>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(extension.extensionValue))
                                                            {
                                                                <details style="margin-top: 2px;">
                                                                    <summary style="cursor: pointer;">原始 JSON</summary>
                                                                    <pre style="white-space: pre-wrap; word-break: break-all; margin: 4px 0 0 0; max-height: 120px; overflow: auto;">@TruncateText(extension.extensionValue, 1200)</pre>
                                                                </details>
                                                            }
                                                        </div>
                                                    }
                                                    @if (display.MessageExtensions.Count > 4)
                                                    {
                                                        <div style="margin-top: 2px;">其余 @(display.MessageExtensions.Count - 4) 条已折叠。</div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (CanForwardMessage(msg)
                                        || CanPullEmojiInfoForMessage(msg, display)
                                        || (isMine && !msg.isRevoked && !msg.isDeleted && msg.msgSvrId.GetValueOrDefault() != 0))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center" Style="margin-top: 2px;">
                                            @if (_multiForwardMode && CanForwardExistingMessage(msg))
                                            {
                                                <RadzenButton Text="@(IsForwardSelected(msg) ? "取消选择" : "选择")"
                                                              Icon="checklist"
                                                              ButtonStyle="@(IsForwardSelected(msg) ? ButtonStyle.Primary : ButtonStyle.Light)"
                                                              Variant="Variant.Text"
                                                              Size="ButtonSize.ExtraSmall"
                                                              Click="@(() => ToggleForwardMessageSelection(msg))" />
                                            }
                                            @if (CanForwardMessage(msg))
                                            {
                                                <RadzenButton Text="转发"
                                                              Icon="forward"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Variant="Variant.Text"
                                                              Size="ButtonSize.ExtraSmall"
                                                              Click="@(() => ForwardChatMessage(msg))"
                                                              Disabled="@_sending" />
                                            }
                                            @if (CanPullEmojiInfoForMessage(msg, display))
                                            {
                                                <RadzenButton Text="补表情"
                                                              Icon="extension"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Variant="Variant.Text"
                                                              Size="ButtonSize.ExtraSmall"
                                                              Click="@(() => PullEmojiMediaForMessage(msg, display))"
                                                              Disabled="@_sending" />
                                            }
                                            @if (isMine && !msg.isRevoked && !msg.isDeleted && msg.msgSvrId.GetValueOrDefault() != 0)
                                            {
                                                <RadzenButton Text="撤回"
                                                              Icon="undo"
                                                              ButtonStyle="ButtonStyle.Light"
                                                              Variant="Variant.Text"
                                                              Size="ButtonSize.ExtraSmall"
                                                              Click="@(() => RevokeChatMessage(msg))" />
                                            }
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </RadzenStack>
                        }
                       <div id="im-scroll-anchor"></div>
                    </RadzenStack>
                </div>

                <!-- Chat Input Area (Fixed Bottom) -->
                <div style="background: var(--rz-base-0); border-top: 1px solid var(--rz-border-color); padding: 0; flex: 0 0 auto; max-height: 55%; min-height: 156px; overflow: hidden; display: flex; flex-direction: column;">
                    <InputFile @ref="_imageInputFile" id="im-chat-image-file" OnChange="UploadAndSendImagesAsync" accept="image/*" multiple style="display:none" />
                    <InputFile @ref="_videoInputFile" id="im-chat-video-file" OnChange="UploadAndSendVideoAsync" accept="video/*" style="display:none" />
                    <InputFile @ref="_anyInputFile" id="im-chat-any-file" OnChange="UploadAndSendFileAsync" style="display:none" />

                    <div style="flex: 0 1 auto; min-height: 0; overflow-y: auto;">
                        <!-- 工具栏 -->
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" AlignItems="AlignItems.Center" Style="padding: 8px 15px; border-bottom: 1px solid var(--rz-border-color); flex-wrap: wrap;">
                            <RadzenButton Text="表情" Icon="sentiment_satisfied_alt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ToggleEmojiPicker" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="图片" Icon="image" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenImagePicker" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="视频" Icon="movie" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenVideoPicker" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="文件" Icon="folder_open" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenAnyFilePicker" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="红包" Icon="redeem" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenLuckyMoneyDialog" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="转账" Icon="payments" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenRemittanceDialog" Disabled="@(_sending || _isUploadingMedia)" />
                            @if (IsCurrentConversationChatRoom())
                            {
                                <RadzenButton Text="接龙" Icon="playlist_add" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenJielongDialog" Disabled="@(_sending || _isUploadingMedia)" />
                            }
                            else
                            {
                                <RadzenButton Text="好友权限" Icon="lock_person" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OpenFriendPermissionDialog" Disabled="@(_sending || _isUploadingMedia)" />
                            }
                            <RadzenButton Text="截图" Icon="content_cut" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="CaptureScreen" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="刷新" Icon="history" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="RefreshCurrentConversation" Disabled="@(_sending || _isUploadingMedia)" />
                            <RadzenButton Text="@(_showForwardSettings ? "收起转发" : "转发设置")" Icon="forward" ButtonStyle="@(_showForwardSettings || _multiForwardMode ? ButtonStyle.Primary : ButtonStyle.Light)" Size="ButtonSize.Small" Click="ToggleForwardSettings" Disabled="@(_sending || _isUploadingMedia)" />
                            @if (_isUploadingMedia)
                            {
                                <RadzenText Text="@_uploadStatus" TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);" />
                            }
                        </RadzenStack>

                        @if (ShouldShowForwardSettingsPanel())
                        {
                            <!-- 转发设置面板：与表情面板分组展示，宽输入框独占行，避免挤压工具栏。 -->
                            <div style="margin: 8px 15px; padding: 10px; border: 1px solid var(--rz-border-color); border-radius: 8px; background: var(--rz-base-50);">
                                <RadzenStack Orientation="Orientation.Vertical" Gap="8px">
                                    <RadzenText Text="转发设置" TextStyle="TextStyle.Caption" Style="font-weight: 600; color: var(--rz-text-secondary-color);" />
                                    <RadzenTextBox @bind-Value="_forwardTargetInput" Placeholder="转发目标 wxid/群ID，多个用逗号；按内容兜底仅单目标" Style="width: 100%;" Disabled="@(_sending || _isUploadingMedia)" />
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" AlignItems="AlignItems.Center" Style="flex-wrap: wrap;">
                                        <RadzenButton Text="选目标" Icon="person_search" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="PickForwardTargets" Disabled="@(_sending || _isUploadingMedia)" />
                                        <RadzenButton Text="@(_multiForwardMode ? "退出多选" : "多选转发")" Icon="library_add_check" ButtonStyle="@(_multiForwardMode ? ButtonStyle.Primary : ButtonStyle.Light)" Size="ButtonSize.Small" Click="ToggleMultiForwardMode" Disabled="@(_sending || _isUploadingMedia)" />
                                        @if (_multiForwardMode)
                                        {
                                            <RadzenButton Text="@($"转发选中({_selectedForwardMsgSvrIds.Count})")" Icon="send" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="ForwardSelectedMessages" Disabled="@(_sending || _isUploadingMedia || _selectedForwardMsgSvrIds.Count == 0)" />
                                        }
                                    </RadzenStack>
                                    <RadzenTextBox @bind-Value="_forwardExtMsg" Placeholder="转发附加说明(可选)" Style="width: 100%;" Disabled="@(_sending || _isUploadingMedia)" />
                                    @if (_multiForwardMode)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center" Style="white-space: nowrap;">
                                            <RadzenCheckBox @bind-Value="_forwardSendRecord" TValue="bool" Name="ForwardSendRecord" />
                                            <span title="开启后按微信聊天记录样式转发；关闭后尝试普通多选转发，实际效果以微信客户端为准。">合并为聊天记录</span>
                                        </RadzenStack>
                                    }
                                </RadzenStack>
                            </div>
                        }

                        @if (_showEmojiPicker)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="6px" Style="padding: 8px 15px; border-bottom: 1px dashed var(--rz-border-color); flex-wrap: wrap;">
                                @foreach (var emoji in QuickEmojis)
                                {
                                    <RadzenButton Text="@emoji" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => AppendEmoji(emoji))" />
                                }
                            </RadzenStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(Store.LastScreenShotUrl))
                        {
                            <div style="padding: 10px 15px; border-bottom: 1px dashed var(--rz-border-color); background: var(--rz-base-50);">
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="12px" AlignItems="AlignItems.Center">
                                    <div style="flex:1;">
                                        <RadzenText Text="最新截图预览" TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);" />
                                        <div>
                                            <a href="@Store.LastScreenShotUrl" target="_blank" style="font-size:12px;">打开原图</a>
                                        </div>
                                    </div>
                                    <RadzenImage Path="@Store.LastScreenShotUrl" Style="width: 100px; max-height: 70px; object-fit: cover; border-radius: 4px;" />
                                </RadzenStack>
                            </div>
                        }
                        @if (HasSelectedDeviceScreenShotState())
                        {
                            <div style="padding: 8px 15px; border-bottom: 1px dashed var(--rz-border-color); background: var(--rz-base-0);">
                                <RadzenText TextStyle="TextStyle.Caption" Style="@GetScreenShotStatusStyle()">
                                    @(Store.LastScreenShotStatusMessage ?? "截图状态未知")
                                </RadzenText>
                            </div>
                        }
                    </div>

                    <!-- 输入框与发送按钮：发送按钮固定在底部对齐 -->
                    <div style="flex: 0 0 auto; padding: 8px 15px 10px; background: var(--rz-base-0); border-top: 1px solid var(--rz-border-color); box-shadow: 0 -2px 6px rgba(0,0,0,0.04);">
                        <div style="display: flex; gap: 10px; align-items: flex-end;">
                            <div style="flex: 1 1 auto; min-width: 0;">
                                <RadzenTextArea @bind-Value="_msgContent" Rows="2" Style="width: 100%; min-height: 56px; max-height: 96px; border: none; box-shadow: none; padding: 8px 12px; resize: vertical; background: var(--rz-base-50); border-radius: 6px;"
                                               Placeholder="请输入内容..." @onkeydown="HandleKeyPress" />
                                <RadzenText Text="按Ctrl + Enter换行" TextStyle="TextStyle.Caption" Style="display: block; margin-top: 4px; color: var(--rz-text-secondary-color);" />
                            </div>
                            <div style="flex: 0 0 auto; display: flex; align-items: flex-end;">
                                <RadzenButton Text="发送" Click="Send" IsBusy="@_sending" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Style="min-width: 82px; height: 40px; padding-left: 20px; padding-right: 20px;" />
                            </div>
                        </div>
                    </div>
                </div>
            </RadzenStack>
        }
    }
    @* 场景三：其它 *@
    else
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%;">
            <RadzenText Text="请选择会话" TextStyle="TextStyle.Body1" Style="color:var(--rz-text-secondary-color);" />
        </RadzenStack>
    }
</RadzenStack>

