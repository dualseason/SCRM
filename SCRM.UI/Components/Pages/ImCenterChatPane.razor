    // 会话、成员与消息归属 helper 已拆分到 ImCenterChatPane.Conversation.cs。

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleStoreChange;
        await LoadUploadBaseUrlAsync();
    }

    public void Dispose()
    {
        Store.OnChange -= HandleStoreChange;
    }

    private void HandleStoreChange()
    {
        InvokeAsync(async () =>
        {
            ResetForwardSelectionIfContextChanged();
            StateHasChanged();
            await ScrollToBottom();
        });
    }

    // 会话头像与消息归属判断已拆分到 ImCenterChatPane.Conversation.cs。

    #region 消息展示解析

    /// <summary>
    /// 构建聊天气泡展示数据。
    /// <para>群聊收到的原始文本通常是“成员wxid:\n正文”；这里仅在展示层拆分，不改数据库原始内容。</para>
    /// </summary>
    private ChatMessageDisplay BuildMessageDisplay(Message msg, bool isMine)
    {
        var parsed = ParseGroupMemberPrefix(msg);
        var body = NormalizePrivateChatBody(msg, parsed.Body, isMine);
        var memberWxid = parsed.MemberWxid;
        var senderName = isMine
            ? ResolveMyDisplayName()
            : ResolveMemberDisplayName(memberWxid, msg.senderWxid);
        var senderAvatar = isMine
            ? (Store.SelectedDevice?.wx?.wechatAccount?.avatarUrl ?? "images/default-avatar.png")
            : ResolveMemberAvatar(memberWxid, msg.senderWxid);
        if (msg.isRevoked)
        {
            return new ChatMessageDisplay
            {
                Body = "消息已撤回",
                SenderDisplayName = senderName,
                Avatar = string.IsNullOrWhiteSpace(senderAvatar) ? "images/default-avatar.png" : senderAvatar,
                ShowSenderName = !isMine && IsCurrentConversationChatRoom(),
                Kind = ChatMessageKind.Text,
                MediaUrl = string.Empty,
                FileName = string.Empty
            };
        }

        var mediaAttachments = NormalizeMediaAttachments(msg);
        var messageExtensions = NormalizeMessageExtensions(msg);
        var advanced = ResolveAdvancedMessageDisplay(messageExtensions);
        var kind = ResolveMessageKind(msg.messageType, body);
        var advancedKind = ResolveMessageKindFromAdvanced(advanced);
        if (advancedKind != ChatMessageKind.Text)
        {
            kind = advancedKind;
        }

        var primaryMedia = SelectPrimaryMediaAttachment(mediaAttachments, kind);
        if (kind == ChatMessageKind.Text && primaryMedia != null)
        {
            kind = ResolveMessageKindFromMediaType(primaryMedia.mediaType, primaryMedia.mediaUrl);
        }

        var mediaUrl = primaryMedia?.mediaUrl ?? ResolveMediaUrl(kind, body);

        return new ChatMessageDisplay
        {
            Body = body,
            SenderDisplayName = senderName,
            Avatar = string.IsNullOrWhiteSpace(senderAvatar) ? "images/default-avatar.png" : senderAvatar,
            ShowSenderName = !isMine && IsCurrentConversationChatRoom(),
            Kind = kind,
            MediaUrl = mediaUrl,
            FileName = ResolveFileDisplayName(body, mediaUrl, advanced),
            MediaAttachments = mediaAttachments,
            MessageExtensions = messageExtensions,
            VoiceTransText = msg.voiceTransText,
            Advanced = advanced
        };
    }

    // 群聊前缀、成员显示名、联系人和会话类型 helper 已拆分到 ImCenterChatPane.Conversation.cs。

    private static ChatMessageKind ResolveMessageKind(short messageType, string body)
    {
        return messageType switch
        {
            2 => ChatMessageKind.Image,
            3 => ChatMessageKind.Voice,
            4 => ChatMessageKind.Video,
            8 => ChatMessageKind.File,
            9 => ChatMessageKind.NameCard,
            10 => ChatMessageKind.Location,
            11 => ChatMessageKind.LuckyMoney,
            12 => ChatMessageKind.MoneyTrans,
            13 => ChatMessageKind.WeApp,
            14 => ChatMessageKind.Emoji,
            18 => ChatMessageKind.Link,
            22 => ChatMessageKind.Quote,
            24 => ChatMessageKind.FinderFeed,
            25 => ChatMessageKind.RoomLiving,
            28 => ChatMessageKind.FinderLive,
            29 or 30 => ChatMessageKind.NameCard,
            99 => ChatMessageKind.Unsupported,
            _ => InferKindFromContent(body)
        };
    }

    // 高级消息展示类型映射已拆分到 ImCenterChatPane.Advanced.cs。

