@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store

<div class="device-list-container">
    @foreach (SrClient srClient in Store.Devices)
    {
        <div class="device-item @(Store.SelectedDevice?.uuid == srClient.uuid ? "active" : "")" 
             @onclick="@(() => SelectDevice(srClient))"
             title="@($"{srClient.weChatNick} ({srClient.device?.PhoneModel})")">
             <div style="position: relative; display: inline-block;">
                @if(!string.IsNullOrEmpty(srClient.weChatAvatar))
                {
                    <RadzenImage Path="@srClient.weChatAvatar" Style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
                }
                else
                {
                    <RadzenIcon Icon="smartphone" Style="font-size: 24px; width: 40px; height: 40px; background-color: #d9d9d9; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white;" />
                }
                <span style="position: absolute; bottom: 0; right: 0; width: 10px; height: 10px; border-radius: 50%; border: 2px solid white; background-color: @(srClient.isOnline ? "#52c41a" : "#bfbfbf");"></span>
             </div>
             <div style="font-size: 10px; color: #666; margin-top: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0 5px;">
                @(!string.IsNullOrEmpty(srClient.device?.PhoneModel) ? srClient.device.PhoneModel : (srClient.device?.PhoneBrand ?? "Device"))
             </div>
        </div>
    }
    <div class="device-item" @onclick="RefreshDevices" title="Refresh Devices">
         <RadzenIcon Icon="refresh" Style="font-size: 24px; color: #666;" />
    </div>
</div>

<style>
    .device-list-container { text-align: center; padding-top: 10px; overflow-y: auto; height: 100%; display: flex; flex-direction: column; align-items: center; }
    .device-item { cursor: pointer; padding: 10px 0; opacity: 0.8; transition: 0.3s; width: 100%; text-align: center; }
    .device-item:hover { opacity: 1; background-color: rgba(0,0,0,0.1); }
    .device-item.active { opacity: 1; border-left: 3px solid var(--rz-primary); background: rgba(0,0,0,0.2); }
</style>

@code {
    [Parameter]
    public EventCallback<SrClient> OnDeviceSelected { get; set; }

    private async Task SelectDevice(SrClient device)
    {
        await Store.SelectDeviceAsync(device);
        if (OnDeviceSelected.HasDelegate)
        {
            await OnDeviceSelected.InvokeAsync(device);
        }
    }

    private async Task RefreshDevices()
    {
        await Store.LoadDevicesAsync();
    }
}
