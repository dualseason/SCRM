@using SCRM.UI.Services
@using SCRM.API.Models.Entities
@using SCRM.SHARED.Models
@using Radzen
@using Radzen.Blazor
@inject CrmStore Store
@inject DialogService DialogService
@inject NotificationService NoticeService

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="width: 100%; max-width: 600px;">
    
    @* Device Info Section *@
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3">Device Information</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem">
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-mb-0">Device Name (Remark)</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1"><b>@(Device.weChatNick ?? "Unknown")</b></RadzenText>
                
                <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-mb-0">Model</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1">@(Device.device?.PhoneModel ?? "Unknown")</RadzenText>
            </RadzenStack>
            
            <RadzenStack Gap="0">
                 <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-mb-0">UUID</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" Style="font-family: monospace;">@Device.uuid</RadzenText>
                
                <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-mb-0">Status</RadzenText>
                <RadzenBadge BadgeStyle="@(Device.isOnline ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(Device.isOnline ? "Online" : "Offline")" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @* Actions Section *@
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" TagName="TagName.H3">Actions</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="Capture Screen" Icon="screenshot_monitor" ButtonStyle="ButtonStyle.Primary" Click="OnCaptureScreen" IsBusy="@_isCapturing" />
            <RadzenButton Text="Sync Contacts" Icon="sync" ButtonStyle="ButtonStyle.Secondary" Click="OnSyncContacts" />
            <RadzenButton Text="Reboot (Mock)" Icon="restart_alt" ButtonStyle="ButtonStyle.Danger" Disabled="true" />
        </RadzenStack>
    </RadzenCard>

    @* Screenshot Display *@
    @if (!string.IsNullOrEmpty(Store.LastScreenShotUrl))
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle2">Latest Screenshot</RadzenText>
            <div style="width: 100%; overflow: auto; max-height: 400px; text-align: center; background: #f0f0f0; padding: 10px;">
                 <RadzenImage Path="@Store.LastScreenShotUrl" Style="max-width: 100%; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
            </div>
        </RadzenCard>
    }
    
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" Style="margin-top: 1rem;">
        <RadzenButton Text="Close" Click="() => DialogService.Close(false)" ButtonStyle="ButtonStyle.Light" />
    </RadzenStack>

</RadzenStack>

@code {
    [Parameter] public SrClient Device { get; set; }

    private bool _isCapturing = false;

    protected override void OnInitialized()
    {
        Store.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Store.OnChange -= StateHasChanged;
    }

    private async Task OnCaptureScreen()
    {
        _isCapturing = true;
        try 
        {
            var success = await Store.RequestScreenShotAsync(Device.uuid);
            if (success)
            {
                NoticeService.Notify(NotificationSeverity.Info, "Summary", "Screenshot requested. Updating...");
                // Optimistic wait, though real update comes via SignalR -> Store
                await Task.Delay(2000); 
            }
            else
            {
                NoticeService.Notify(NotificationSeverity.Error, "Error", "Failed to send request (Device offline or not found).");
            }
        }
        catch (Exception ex)
        {
            NoticeService.Notify(NotificationSeverity.Error, "Error", $"Request failed: {ex.Message}");
        }
        finally
        {
            _isCapturing = false;
        }
    }

    private async Task OnSyncContacts()
    {
        await Store.SyncContactsAsync(); // Store typically syncs selected device, need to ensure logic holds or pass ID
        NoticeService.Notify(NotificationSeverity.Info, "Summary", "Sync contacts requested.");
    }
}
